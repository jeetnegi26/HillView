        }

    .contact-box {
        padding-bottom: 3rem;
    }

    .contact-form {
        margin: 20px auto;
    }

        .contact-form .form-label {
            margin-bottom: 6px;
            font-size: 16px;
        }

        .contact-form .form-control {
            border: 1px solid #007bff;
            border-radius: 10px;
            background: transparent;
            box-shadow: none;
            padding: 10px 12px;
        }

        .contact-form input.form-control {
            height: 44px;
        }

        .contact-form textarea.form-control {
            height: 110px;
            resize: vertical;
        }

        .contact-form .form-control:focus {
            border-color: #007bff;
            box-shadow: none;
        }

    .contact-form {
        margin: 20px auto;
    }

        .contact-form .form-label {
            margin-bottom: 6px;
            font-size: 16px;
        }

        .contact-form .form-control {
            border: 1px solid #007bff;
            border-radius: 10px;
            box-shadow: none;
            padding: 10px 12px;
        }

        .contact-form input.form-control {
            height: 44px;
        }

        .contact-form textarea.form-control {
            height: 110px;
            resize: vertical;
        }

        .contact-form .form-control:focus {
            border-color: #007bff;
            box-shadow: none;
        }

        .contact-form .btn-secondary {
            width: 188px;
            padding: 12px;
            border-radius: 8px;
            font-weight: 600;
        }

    .contact-form-box, .contact-desc {
        padding: 0 2rem;
    }

    .contact-form-items .form-group {
        padding-bottom: 1rem;
    }

        .contact-form-items .form-group label {
            color: var(--text);
            padding-bottom: 0.5rem;
        }

    .contact-left-item {
        display: flex;
        align-items: center;
    }

    .contact-form-box {
        width: 100%
    }

    .contact-desc h1 {
        padding-bottom: 2rem;
        font-weight600;
    }

    .cont-desc-text {
        padding-bottom: 2rem;
        margin-bottom: 2rem;
        border-bottom: 1px solid var(--primary);
    }

    .contact-desc p i {
        color: var(--primary);
        padding-right: 1rem;
    }

    @@media screen and (min-width: 1024px) and (max-width: 1339px) {
        .contact-box {
            padding: 3rem;
        }
    }

    @@media screen and (min-width: 600px) and (max-width: 1023px) {
        .contact-box {
            padding: 3rem;
        }
    }

    @@media (max-width: 600px) {
        .banner-text {
            max-width: 400px;
            text-align: left;
        }

        .contact-form-box, .contact-desc {
            padding: 0 0rem;
        }
    }

    @@media (max-width: 430px) {
        .banner-text {
            max-width: 350px;
        }
    }

    @@media (max-width: 380px) {
        .banner-text {
            max-width: 340px;
        }
    }
</style>

@if (data != null)
{
    <section class="banner">
        <div class="orb-scene">
            @if (images != null && images.Count > 0 && !string.IsNullOrWhiteSpace(images[0].ImageUrl))
            {
                <img class="orb orb-1" src="@Url.Content("~/content/uploads/" + images[0].ImageUrl)" alt="@(images[0].AltText ?? "")" />
            }
            @if (images != null && images.Count > 1 && !string.IsNullOrWhiteSpace(images[1].ImageUrl))
            {
                <img class="orb orb-2" src="@Url.Content("~/content/uploads/" + images[1].ImageUrl)" alt="@(images[1].AltText ?? "")" />
            }

            <div class="banner-text-box">
                <div class="banner-text">
                    <small>@data.SubHeading</small>
                    <h2>
                        @data.Heading
                    </h2>
                    <h2>
                        @data.Description
                    </h2>
                </div>
            </div>
        </div>
    </section>
}
