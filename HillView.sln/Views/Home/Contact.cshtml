                            <form id="contactForm" class="contact-form" method="post">
                                @Html.AntiForgeryToken()

                                <div class="contact-form-items">
                                    <div class="form-group">
                                        <label for="FullName" class="form-label">Full name</label>
                                        <input type="text" class="form-control" id="FullName" name="FullName"
                                               maxlength="250" required>
                                    </div>

                                    <div class="form-group">
                                        <label for="Email" class="form-label">Email address</label>
                                        <input type="email" class="form-control" id="Email" name="Email"
                                               maxlength="250" required>
                                    </div>

                                    <div class="form-group">
                                        <label for="Phone" class="form-label">Phone</label>
                                        <input type="tel" class="form-control" id="Phone" name="Phone"
                                               maxlength="20" pattern="[0-9+()\-\s]*">
                                    </div>

                                    <div class="mb-3 form-group">
                                        <label for="Message" class="form-label">Message</label>
                                        <textarea class="form-control" id="Message" name="Message" rows="4"
                                                  maxlength="4000" required></textarea>
                                    </div>

                                    @* Honeypot: hidden from people, bots fill it in *@
                                    <div style="position:absolute; left:-9999px;" aria-hidden="true">
                                        <label for="Website">Leave this field empty</label>
                                        <input type="text" id="Website" name="Website" tabindex="-1" autocomplete="off">
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-secondary">Submit</button>
                                <div id="contactStatus" class="mt-3" role="status"></div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


@{
    var aitalent = Model?.Sections?.Where(x => x != null && x.DisplayOrder == 3).ToList();
}
@Html.Action("aitalent", "Home", new { sections = aitalent })

<script>
    $(function () {
        $("#contactForm").on("submit", function (e) {
            e.preventDefault();

            var $form = $(this);
            var $button = $form.find("button[type='submit']");
            var $status = $("#contactStatus");

            $status.removeClass("text-success text-danger").text("");
            $button.prop("disabled", true);

            $.ajax({
                url: '@Url.Action("SubmitContact", "Home")',
                type: "POST",
                data: $form.serialize(),
                success: function (response) {
                    if (response && response.success) {
                        $form[0].reset();
                        $status.addClass("text-success");
                    } else {
                        $status.addClass("text-danger");
                    }
                    $status.text(response && response.message
                        ? response.message
                        : "Something went wrong. Please try again.");
                },
                error: function () {
                    $status.addClass("text-danger")
                           .text("Unable to send your message. Please try again.");
                },
                complete: function () {
                    $button.prop("disabled", false);
                }
            });
        });
    });
</script>