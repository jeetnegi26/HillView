@model DTOs.UIPageVM
@using System.Linq
@using DTOs
@{
    ViewBag.Title = string.IsNullOrWhiteSpace(Model.MetaTitle) ? Model.Title : Model.MetaTitle;

    var data = Model?.Sections?.FirstOrDefault(x => x != null && x.DisplayOrder == 1);
    var images = data?.Images?.Where(x => x != null).ToList();
    var buttons = data?.Buttons?.Where(x => x != null).ToList();

    var data2 = Model?.Sections?.FirstOrDefault(x => x != null && x.DisplayOrder == 2);
    var data4 = Model?.Sections?.FirstOrDefault(x => x != null && x.DisplayOrder == 4);
    var data6 = Model?.Sections?.FirstOrDefault(x => x != null && x.DisplayOrder == 6);

}

<link href="~/Content/css/otherbanner.css" rel="stylesheet" />
<link href="~/Content/css/owl.carousel.min.css" rel="stylesheet" />

<style>
    .banner-text-box {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    .banner-text {
        max-width: 900px;
        text-align: center;
        position: absolute;
    }

        .banner-text small {
            color: var(--primary)
        }

    .adv-box .home-head {
        display: none;
    }

    .home-head {
        max-width: 800px;
    }

    .about-head {
        display: flex;
        justify-content: center;
    }

    *:has(> .why-us),
    *:has(> .adv-img) {
        display: none !important;
    }

    .about-head, .milestomes-head {
        display: flex;
        justify-content: center;
    }

    .why-us-items-box {
        padding: 2.5rem;
        border: 1px solid var(--secondary);
        border-radius: 25px;
        margin-bottom: 5rem;
        background: var(--lightbg);
    }

    .why-us-item {
        display: flex;
        padding: 1rem 1.5rem 1rem 0;
    }

    .why-us-item-icon {
        padding-right: 1rem;
    }

        .why-us-item-icon .bi-check-circle {
            color: var(--primary);
        }

    .why-us-item-desc h3 {
        font-weight: 600;
    }

    .why-us-item-desc p {
        margin: 0
    }

    .team-item {
        padding: 5rem 0;
    }

    .team-desc {
        padding-left: 5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .team-carousel-container-box {
        background: var(--lightbg);
    }

    .team-item-desc {
        display: flex;
    }

    .team-desc h3 {
        color: var(--secondary);
    }

    .team-desc h1 {
        font-weight: 600;
    }

    .team-desc p {
        padding-top: 2rem;
        padding-bottom: 2rem;
    }

    .team-desc a {
        color: var(--secondary);
    }

    .team-item-btns .btn-secondary {
        margin-right: 1rem;
    }

    @@media screen and (min-width: 1024px) and (max-width: 1339px) {
        .about-desc-row {
            padding-top: 2rem;
        }

        *:has(> .adv-img) {
            display: block !important;
            width: 50% !important;
        }

        .team-desc {
            padding-left: 1rem;
        }
    }

    @@media screen and (min-width: 600px) and (max-width: 1023px) {
        .banner-text {
            max-width: 675px;
        }

        h2 {
            font-size: 21px;
        }

        .about-desc-row {
            padding-top: 2rem;
        }

        *:has(> .adv-img) {
            display: block !important;
            width: 50% !important;
        }

        .why-us-items-box {
            margin-bottom: 0rem;
        }

        .team-desc {
            padding: 2rem 1rem;
        }
    }

    @@media (max-width: 600px) {
        .banner-text {
            max-width: 400px;
            text-align: left;
        }

        .why-us-items-box {
            padding: 2.5rem 1rem;
            margin: 0 1rem;
        }

        .why-us-item {
            padding: 1rem 0;
        }

        .team-desc {
            padding: 2rem 1rem;
        }
    }

    @@media (max-width: 430px) {
        .banner-text {
            max-width: 350px;
        }
    }

    @@media (max-width: 380px) {
        .banner-text {
            max-width: 340px;
        }
    }
    }
</style>

@if (data != null)
{
    <section class="banner">
        <div class="orb-scene">
            @if (images != null && images.Count > 0 && !string.IsNullOrWhiteSpace(images[0].ImageUrl))
            {
                <img class="orb orb-1" src="@Url.Content("~/content/uploads/" + images[0].ImageUrl)" alt="@(images[0].AltText ?? "")" />
            }
            @if (images != null && images.Count > 1 && !string.IsNullOrWhiteSpace(images[1].ImageUrl))
            {
                <img class="orb orb-2" src="@Url.Content("~/content/uploads/" + images[1].ImageUrl)" alt="@(images[1].AltText ?? "")" />
            }

            <div class="banner-text-box">
                <div class="banner-text">
                    <small>@data.Title</small>
                    <h2>
                        @data.Description
                    </h2>
                </div>
            </div>
        </div>
    </section>
}

@if (data2 != null)
{
    <section class="about-desc-section">
        <div class="about-desc-container container">
            <div class="about-desc-row row ">
                <div class="about-desc-box col-lg-6 col-md-8 col-12 ">
                    <div class="about-desc">
                        <p>
                            @data2.Description
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

@{
    var advantageSections = Model?.Sections?.Where(x => x != null && (x.DisplayOrder == 3 || x.DisplayOrder == 4)).ToList();
}

@Html.Action("advantages", "Home",
    new { sections = advantageSections })


