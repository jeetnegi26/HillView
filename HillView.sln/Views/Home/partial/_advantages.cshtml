            }



        /* -------------------------
           COLORFUL BOX AREA
        ------------------------- */

        .success-points-container {
            position: relative;
            flex: 1;
            margin-top: 1rem;
            overflow: hidden;
        }


        /* Common box */

        .success-point {
            position: absolute;
            padding: 0.6rem 1rem;
            border-radius: 2rem;
            color: #fff;
            font-size: 12px;
            white-space: nowrap;
            opacity: 0;
            animation-name: fallDown;
            animation-duration: 1s;
            animation-timing-function: cubic-bezier(.2, .8, .3, 1);
            animation-fill-mode: forwards;
        }


        /* -------------------------
           POSITIONS
        ------------------------- */

        .point-1 {
            --rotation: 38deg;
            left: -2%;
            top: 6.5rem;
            background: #ff6797;
            animation-delay: .1s;
            z-index: 16;
        }

        .point-2 {
            --rotation: 38deg;
            left: 11%;
            top: 5.5rem;
            background: #9b6bea;
            animation-delay: .3s;
        }

        .point-3 {
            --rotation: -20deg;
            right: 0%;
            top: 3rem;
            background: #20b9d4;
            animation-delay: .5s;
        }

        .point-4 {
            --rotation: -20deg;
            right: -1%;
            top: 6.5rem;
            background: #e99b91;
            animation-delay: .7s;
        }

        .point-5 {
            --rotation: -14deg;
            left: 4%;
            top: 11rem;
            background: #168cff;
            animation-delay: .9s;
        }

        .point-6 {
            --rotation: 0deg;
            right: 3%;
            top: 10.5rem;
            background: #f5aa32;
            animation-delay: 1.1s;
        }


        /* -------------------------
           FALLING ANIMATION
        ------------------------- */

        @@keyframes fallDown {

            0% {
                opacity: 0;
                transform: translateY(-180px) rotate(0deg);
            }

            60% {
                opacity: 1;
                transform: translateY(12px) rotate(var(--rotation));
            }

            80% {
                transform: translateY(-5px) rotate(var(--rotation));
            }

            100% {
                opacity: 1;
                transform: translateY(0) rotate(var(--rotation));
            }
        }


    .comp {
        background-image: url('../../content/images/home/graph-bg.png');
