
<style>
    .adv-box h3 {
        color: var(--primary)
    }

    .adv-sec {
        padding: 2rem 2.5rem;
        border: 1px solid #0285FE;
        border-radius: 10px;
        background: var(--gradient1);
        margin-bottom: 2rem;
        height: 30rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        .adv-sec h3 {
            font-size: 18px;
            color: var(--text);
            font-weight: 300;
        }

        .adv-sec p {
            font-size: 14px;
        }

    .roi-points {
        display: flex;
        width: fit-content;
        border: 1px solid #0285FE;
        padding: 10px 30px;
        margin-bottom: 18px;
        border-radius: 25px;
        background: var(--gradient1);
    }

        .roi-points h3 {
            width: -webkit-fill-available;
            font-size: 14px;
            margin-bottom: 0;
            align-self: center;
        }


        .roi-points img {
            width: 10%;
            margin-left: 2rem;
            width: 15%;
            border-radius: 25px;
        }



    /* -------------------------
           COLORFUL BOX AREA
        ------------------------- */

    .success-points-container {
        position: relative;
        flex: 1;
        margin-top: 1rem;
        overflow: hidden;
    }


    /* Common box */

    .success-point {
        position: absolute;
        padding: 0.6rem 1rem;
        border-radius: 2rem;
        color: #fff;
        font-size: 12px;
        white-space: nowrap;
        opacity: 0;
        animation-name: fallDown;
        animation-duration: 1s;
        animation-timing-function: cubic-bezier(.2, .8, .3, 1);
        animation-fill-mode: forwards;
    }


    /* -------------------------
           POSITIONS
        ------------------------- */

    .point-1 {
        --rotation: 38deg;
        left: -2%;
        top: 6.5rem;
        background: #ff6797;
        animation-delay: .1s;
        z-index: 16;
    }

    .point-2 {
        --rotation: 38deg;
        left: 11%;
        top: 5.5rem;
        background: #9b6bea;
        animation-delay: .3s;
    }

    .point-3 {
        --rotation: -20deg;
        right: 0%;
        top: 3rem;
        background: #20b9d4;
        animation-delay: .5s;
    }

    .point-4 {
        --rotation: -20deg;
        right: -1%;
        top: 6.5rem;
        background: #e99b91;
        animation-delay: .7s;
    }

    .point-5 {
        --rotation: -14deg;
        left: 4%;
        top: 11rem;
        background: #168cff;
        animation-delay: .9s;
    }

    .point-6 {
        --rotation: 0deg;
        right: 3%;
        top: 10.5rem;
        background: #f5aa32;
        animation-delay: 1.1s;
    }


    /* -------------------------
           FALLING ANIMATION
        ------------------------- */

    @@keyframes fallDown {

        0% {
            opacity: 0;
            transform: translateY(-180px) rotate(0deg);
        }

        60% {
            opacity: 1;
            transform: translateY(12px) rotate(var(--rotation));
        }

        80% {
            transform: translateY(-5px) rotate(var(--rotation));
        }

        100% {
            opacity: 1;
            transform: translateY(0) rotate(var(--rotation));
        }
    }


    .comp {
/*        background-image: url('../../content/images/home/graph-bg.png');*/
        background-position: bottom;
        background-size: cover;
        background-repeat: no-repeat;
        justify-content: flex-start
    }

    .why-us .bi-check-circle-fill {
        color: green;
    }

    .adv-img {
/*        background-image: url('../../content/images/home/adv-img.png');*/
        background-position: center;
        background-size: cover;
        background-repeat: no-repeat;
        justify-content: flex-start
    }

    @@media screen and (min-width: 1024px) and (max-width: 1049px) {
        .point-1 {
            left: 3%;
            top: 6.75rem;
        }

        .point-2 {
            left: 14%;
        }

        .point-3 {
            right: 10%;
        }

        .point-4 {
            right: 13%;
        }

        .point-5 {
            left: 10%;
        }

        .point-6 {
            right: 10%;
        }
    }

    @@media screen and (min-width: 600px) and (max-width: 1023px) {
        .point-1 {
            left: 2%;
            top: 6.7rem;
        }

        .point-2 {
            left: 3%;
            top: 4rem;
        }

        .point-3 {
            right: 0%;
        }

        .point-4 {
            right: 7%;
        }

        .point-5 {
            left: 8%;
        }

        .point-6 {
            right: -1%;
        }

        .adv-sec {
            padding: 1.5rem 1.3rem;
        }
    }
</style>


@model List<DTOs.UISectionVM>

@if (Model != null && Model.Count > 0)
{
    var mainSection = Model.ElementAtOrDefault(0);
    var whySection = Model.ElementAtOrDefault(1);

    <section class="advantage-section">
        <div class="adv-container">
            <div class="adv-box">

                @if (mainSection != null)
                {
                    <div class="home-head">
                        @if (!string.IsNullOrWhiteSpace(mainSection.SubHeading))
                        {
                            <h3>@mainSection.SubHeading</h3>
                        }

                        @if (!string.IsNullOrWhiteSpace(mainSection.Heading))
                        {
                            <h2>@mainSection.Heading</h2>
                        }
                    </div>
                }

                <div class="advantages-grid">
                    <div class="container">
                        <div class="row">

                            @if (mainSection != null)
                            {
                                var sectionItems = mainSection.Items?
                                    .Where(x => x != null)
                                    .ToList();

                                if (sectionItems != null && sectionItems.Count > 0)
                                {
                                    var item0 = sectionItems.ElementAtOrDefault(0);
                                    var item1 = sectionItems.ElementAtOrDefault(1);
                                    var item2 = sectionItems.ElementAtOrDefault(2);

                                    @* ROI section *@
                                    if (item0 != null)
                                    {
                                        <div class="col-xl-4 col-lg-6 col-md-6 col-12">
                                            <div class="roi adv-sec">
                                                <div>
                                                    @if (!string.IsNullOrWhiteSpace(item0.Heading))
                                                    {
                                                        <h3>@item0.Heading</h3>
                                                    }

                                                    @if (!string.IsNullOrWhiteSpace(item0.Description))
                                                    {
                                                        <p>@item0.Description</p>
                                                    }
                                                </div>

                                                <div>
                                                    @{
                                                        var children = item0.Children?
                                                            .Where(x => x != null)
                                                            .ToList();
                                                    }

                                                    @if (children != null)
                                                    {
                                                        foreach (var child in children.Take(3))
                                                        {
                                                            <div class="roi-points">
                                                                @if (!string.IsNullOrWhiteSpace(child.Title))
                                                                {
                                                                    <h3>@child.Title</h3>
                                                                }

                                                                @{
                                                                    var image = child.Images?
                                                                        .FirstOrDefault(x =>
                                                                            x != null &&
                                                                            !string.IsNullOrWhiteSpace(x.ImageUrl));
                                                                }

                                                                @if (image != null)
                                                                {
                                                                    <img src="@Url.Content("~/Content/Uploads/" + image.ImageUrl)"
                                                                         alt="@(image.AltText ?? "")" />
                                                                }
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }

                                    @* Success section *@
                                    if (item1 != null)
                                    {
                                        <div class="col-xl-4 col-lg-6 col-md-6 col-12">
                                            <div class="roi adv-sec">

                                                <div class="success-content">
                                                    @if (!string.IsNullOrWhiteSpace(item1.Heading))
                                                    {
                                                        <h3>@item1.Heading</h3>
                                                    }

                                                    @if (!string.IsNullOrWhiteSpace(item1.Description))
                                                    {
                                                        <p>@item1.Description</p>
                                                    }
                                                </div>

                                                @{
                                                    var children2 = item1.Children?
                                                        .Where(x => x != null)
                                                        .ToList();
                                                }

                                                @if (children2 != null && children2.Count > 0)
                                                {
                                                    <div class="success-points-container">
                                                        @{
                                                            var pointClasses = new[]
                                                            {
                                                                "point-1",
                                                                "point-2",
                                                                "point-3",
                                                                "point-4",
                                                                "point-5",
                                                                "point-6"
                                                            };
                                                        }

                                                        @for (int i = 0; i < Math.Min(children2.Count, pointClasses.Length); i++)
                                                        {
                                                            <div class="success-point @pointClasses[i]">
                                                                @children2[i].Title
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }

                                    @* Comparison section *@
                                    if (item2 != null)
                                    {
                        <div class="col-xl-4 col-lg-6 col-md-6 col-12">
                            @{
                                var compImage = item2.Images?
                                    .FirstOrDefault(x => x != null &&
                                                         !string.IsNullOrWhiteSpace(x.ImageUrl));
                            }
                            <div class="comp adv-sec" @if (compImage != null) { @: style="background-image: url('@Url.Content("~/Content/Uploads/" + compImage.ImageUrl)');"
                                 }>


                                <div>
                                    @if (!string.IsNullOrWhiteSpace(item2.Heading))
                                    {
                                        <h3>@item2.Heading</h3>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item2.Description))
                                    {
                                        <p>@item2.Description</p>
                                    }
                                </div>
                                <div></div>
                            </div>
                        </div>
                                    }
                                }
                            }

                            @* Why us section *@
                            @if (whySection != null)
                            {
                                <div class="col-xl-5 col-lg-6 col-md-6 col-12">
                                    <div class="why-us adv-sec">
                                        <div>
                                            @if (!string.IsNullOrWhiteSpace(whySection.Title))
                                            {
                                                <h3>@whySection.Title</h3>
                                            }

                                            @if (!string.IsNullOrWhiteSpace(whySection.Description))
                                            {
                                                <p>@whySection.Description</p>
                                            }
                                        </div>

                                        <div>
                                            @{
                                                var whyItems = whySection.Items?
                                                    .Where(x => x != null)
                                                    .ToList();
                                            }

                                            @if (whyItems != null)
                                            {
                                                foreach (var item in whyItems)
                                                {
                                                    <div class="adv-line d-flex">
                                                        <i class="bi bi-check-circle-fill pr-1"></i>
                                                        <p class="px-2">@item.Title</p>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>

                                <div class="col-xl-7 col-lg-12 col-md-12 col-12">
                                    @{
                                        var advImage = whySection.Images?
                                            .FirstOrDefault(x => x != null &&
                                                                 !string.IsNullOrWhiteSpace(x.ImageUrl));
                                    }

                                    <div class="adv-img adv-sec"
                                         @if (advImage != null) { @: style="background-image: url('@Url.Content("~/Content/Uploads/" + advImage.ImageUrl)');"
                                         }>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}



