@{
    ViewBag.Title = "CSHTHL | Technology & Business Solutions";
}

<link href="~/Content/css/banner.css" rel="stylesheet" />
<link href="~/Content/css/owl.carousel.min.css" rel="stylesheet" />
<style>
    .ai-icon {
        width: 27%;
        padding-right: 4px;
    }

    .banner-text-box {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    .banner-text {
        max-width: 800px;
        text-align: center;
        position: absolute;
    }

        .banner-text > * {
            margin: 5px 0;
        }

    .home-services-container {
        padding: 5rem 0;
    }

    .ser-desc-box {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .ser-desc-box .home-head {
            padding: 0 0 3rem 0;
            text-align: left;
        }

    .ser-icon img {
        width: 4rem;
        padding-right: 1rem;
    }

    .service-item {
        padding-bottom: 2rem;
    }

    .ser-img-box {
        padding-left: 5rem;
    }

    .candidate-section {
        position: relative;
        overflow: hidden;
    }

        /* Faded circular glow */
        .candidate-section::before {
            content: "";
            position: absolute;
            width: 700px;
            height: 700px;
            left: 50%;
            top: 45%;
            transform: translate(-50%, -50%);
            background: radial-gradient( circle, rgba(0, 150, 150, 0.45) 0%, rgba(0, 120, 120, 0.25) 25%, rgba(0, 100, 100, 0.10) 45%, rgba(0, 100, 100, 0) 72% );
            pointer-events: none;
            z-index: 0;
        }

    /* Keep your actual content above the glow */
    .candidate-box {
        position: relative;
        z-index: 1;
    }

    .candidate-icon-bold {
        font-weight: bold;
    }

    .candidate-list-box {
        padding: 0 5rem 3rem;
    }

    .candidate-col-box {
        padding: 1rem;
    }

    .candidate-item {
        padding: 2rem;
        border: 1px solid var(--text);
        border-radius: 20px;
        background: var(--gradient1);
    }

    .candidate-icon .bi {
        font-size: 1.5rem;
        color: var(--primary);
        padding-right: 1rem;
    }

    .candidate-desc p {
        margin-bottom: 0;
    }

    .candidate-knowmore {
        padding-bottom: 5rem;
    }

    .home-jobs-box, .reviews-box, .ai-talent-section {
        background: var(--lightbg)
    }

    .home-jobs-item-box {
        padding-bottom: 5rem;
    }

    .job-item {
        padding: 1.3rem 2rem;
        border: 1px solid var(--secondary);
        border-radius: 25px;
        background: var(--gradient1);
    }

    .time {
        color: var(--text);
        font-size: 12px;
        opacity: 0.8;
    }

    .designation {
        padding-top: 1rem;
        margin-bottom: 0.5rem;
        font-weight: 500;
    }

    .job-location {
        color: var(--primary);
        font-size: 14px;
    }

    .job-desc {
        font-size: 14px;
    }

    .job-carousel .owl-dots {
        margin-top: 25px;
        text-align: center;
    }

    .job-carousel .owl-dot {
        border: none;
        background: transparent;
        padding: 0;
    }

        .job-carousel .owl-dot span {
            width: 10px;
            height: 10px;
            margin: 5px;
            display: block;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.25);
            transition: all 0.3s ease;
        }

        .job-carousel .owl-dot.active span {
            width: 25px;
            border-radius: 10px;
            background: var(--primary);
        }

    .case-item {
        padding: 5rem 0;
    }

    .case-desc {
        padding-left: 5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .case-item-desc {
        display: flex;
    }

    .case-desc h3 {
        color: var(--primary);
    }

    .case-desc h1 {
        font-weight: 600;
    }

    .case-desc p {
        margin-bottom: 2rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--primary)
    }

    .case-item-btns .btn-secondary {
        margin-right: 1rem;
    }

    .review-stars {
        padding-bottom: 10px;
    }

    .review-item .bi-star-fill, .review-item .bi-star, .review-name {
        color: var(--primary);
    }

    .reviews-carousel-box {
        padding-bottom: 5rem;
    }

    .mile-faq-bg {
        position: relative;
        z-index: 1;
    }

        .mile-faq-bg::before {
            content: "";
            position: absolute;
            width: 1000px;
            height: 1000px;
            left: 50%;
            top: 45%;
            transform: translate(-50%, -50%);
            background: radial-gradient(circle, rgba(0, 150, 150, 0.45) 0%, rgba(0, 120, 120, 0.25) 25%, rgba(0, 100, 100, 0.10) 45%, rgba(0, 100, 100, 0) 72%);
            pointer-events: none;
            z-index: 0;
        }


    .faq-section {
        width: 100%;
        padding: 5rem 2rem;
        ;
        color: #fff;
        /* No background: inherits the body's background */
        box-sizing: border-box;
    }

    .faq-title {
        margin: 0 0 60px;
        text-align: center;
        font-size: 36px;
        line-height: 1.4;
        font-weight: 500;
        letter-spacing: -0.7px;
    }

    .faq-list {
        width: 100%;
        border-top: 1px solid rgba(255, 255, 255, 0.22);
    }

    .faq-item {
        border-bottom: 1px solid rgba(255, 255, 255, 0.22);
        transition: border-color 0.25s ease;
    }

        .faq-item.active {
            border-bottom-color: var(--primary);
        }

    .faq-question {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        width: 100%;
        padding: 2rem 0;
        border: 0;
        background: transparent;
        color: var(--text);
        font: inherit;
        font-size: 20px;
        line-height: 1.4;
        text-align: left;
        cursor: pointer;
    }

    .faq-icon {
        flex-shrink: 0;
        font-size: 28px;
        line-height: 1;
        font-weight: 300;
        transition: transform 0.25s ease;
    }

    .faq-item {
        border-top: 1px solid var(--text);
    }

    .faq-answer {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.3s ease;
        border-top: 1px solid var(--text);
    }

    .faq-item.active .faq-answer {
        border-top: 1px solid var(--primary);
    }

    .faq-answer p {
        overflow: hidden;
        min-height: 0;
        margin: 0;
        color: rgba(255, 255, 255, 0.8);
        font-size: 20px;
        line-height: 1.3;
    }

    .faq-item.active .faq-answer {
        grid-template-rows: 1fr;
    }

        .faq-item.active .faq-answer p {
            padding: 2rem 0;
        }

    .faq-question:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 4px;
    }

    @@media (max-width: 600px) {
        .faq-section {
            padding: 32px 20px;
        }

        .faq-title {
            margin-bottom: 36px;
            font-size: 28px;
        }

        .faq-question {
            padding: 20px 0;
            font-size: 17px;
        }

        .faq-answer p {
            font-size: 16px;
            line-height: 1.5;
        }

        .faq-item.active .faq-answer p {
            padding: 4px 0 22px;
        }
    }
</style>

