@model DTOs.UIPageVM
@using System.Linq
@using DTOs
@{
    ViewBag.Title = string.IsNullOrWhiteSpace(Model.MetaTitle) ? Model.Title : Model.MetaTitle;

    var data = Model?.Sections?
    .FirstOrDefault(x => x != null && x.DisplayOrder == 1);

    var images = data?.Images?
        .Where(x => x != null)
        .ToList();

    var buttons = data?.Buttons?
        .Where(x => x != null)
        .ToList();

    var dataService = Model?.Sections?.FirstOrDefault(x => x != null && x.DisplayOrder == 4);
    var data5 = Model?.Sections?.FirstOrDefault(x => x != null && x.DisplayOrder == 5);
    var data6 = Model?.Sections?.FirstOrDefault(x => x != null && x.DisplayOrder == 6);
    var data8 = Model?.Sections?.FirstOrDefault(x => x != null && x.DisplayOrder == 8);

    var data10 = Model?.Sections?.FirstOrDefault(x => x != null && x.DisplayOrder == 10);

    var reviews = Model.Testimonials.ToList();
}

<link href="~/Content/css/banner.css" rel="stylesheet" />
<link href="~/Content/css/owl.carousel.min.css" rel="stylesheet" />

<style>
    .ai-icon {
        width: 27%;
        padding-right: 4px;
    }

    .banner-text-box {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    .banner-text {
        max-width: 800px;
        text-align: center;
        position: absolute;
    }

        .banner-text > * {
            margin: 5px 0;
        }

    .home-services-container {
        padding: 5rem 0;
    }

    .ser-desc-box {
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .ser-desc-box .home-head {
            padding: 0 0 3rem 0;
            text-align: left;
        }

    .ser-icon img {
        width: 4rem;
        padding-right: 1rem;
    }

    .service-item {
        padding-bottom: 2rem;
    }

    .ser-img-box {
        padding-left: 5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .candidate-section {
        position: relative;
        overflow: hidden;
    }

        /* Faded circular glow */
        .candidate-section::before {
            content: "";
            position: absolute;
            width: 700px;
            height: 700px;
            left: 50%;
            top: 45%;
            transform: translate(-50%, -50%);
            background: radial-gradient( circle, rgba(0, 150, 150, 0.45) 0%, rgba(0, 120, 120, 0.25) 25%, rgba(0, 100, 100, 0.10) 45%, rgba(0, 100, 100, 0) 72% );
            pointer-events: none;
            z-index: 0;
        }

    /* Keep your actual content above the glow */
    .candidate-box {
        position: relative;
        z-index: 1;
    }

    .candidate-icon-bold {
        font-weight: bold;
    }

    .candidate-list-box {
        padding: 0 5rem 3rem;
    }

    .candidate-col-box {
        padding: 1rem;
    }

    .candidate-row {
        display: flex;
        flex-wrap: wrap;
    }

    .candidate-col-box {
        display: flex;
        margin-bottom: 20px;
    }

    .candidate-item {
        display: flex;
        width: 100%;
        height: 100%;
        align-items: flex-start;
        padding: 2rem;
        border: 1px solid var(--text);
        border-radius: 20px;
        background: var(--gradient1);
    }

    .candidate-icon .bi {
        font-size: 1.5rem;
        color: var(--primary);
        padding-right: 1rem;
    }

    .candidate-desc p {
        margin-bottom: 0;
    }

    .candidate-knowmore {
        padding-bottom: 5rem;
    }

    .home-jobs-box, .reviews-box, .ai-talent-section {
        background: var(--lightbg)
    }

    .home-jobs-item-box {
        padding-bottom: 5rem;
    }

    .job-item {
        padding: 1.3rem 2rem;
        border: 1px solid var(--secondary);
        border-radius: 25px;
        background: var(--gradient1);
    }

    .time {
        color: var(--text);
        font-size: 12px;
        opacity: 0.8;
    }

    .designation {
        padding-top: 1rem;
        margin-bottom: 0.5rem;
        font-weight: 500;
    }

    .job-location {
        color: var(--primary);
        font-size: 14px;
    }

    .job-desc {
        font-size: 14px;
    }

    .job-carousel .owl-dots {
        margin-top: 25px;
        text-align: center;
    }

    .job-carousel .owl-dot {
        border: none;
        background: transparent;
        padding: 0;
    }

        .job-carousel .owl-dot span {
            width: 10px;
            height: 10px;
            margin: 5px;
            display: block;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.25);
            transition: all 0.3s ease;
        }

        .job-carousel .owl-dot.active span {
            width: 25px;
            border-radius: 10px;
            background: var(--primary);
        }

    .case-item {
        padding: 5rem 0;
    }

    .case-desc {
        padding-left: 5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .case-item-desc {
        display: flex;
    }

    .case-desc h3 {
        color: var(--primary);
    }

    .case-desc h1 {
        font-weight: 600;
    }

    .case-desc p {
        margin-bottom: 2rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--primary)
    }

    .case-item-btns .btn-secondary {
        margin-right: 1rem;
    }

    .review-stars {
        padding-bottom: 10px;
    }

    .review-item .bi-star-fill, .review-item .bi-star, .review-name {
        color: var(--primary);
    }

    .reviews-carousel-box {
        padding-bottom: 5rem;
    }

    .mile-faq-bg {
        position: relative;
        z-index: 1;
    }

        .mile-faq-bg::before {
            content: "";
            position: absolute;
            width: 1000px;
            height: 1000px;
            left: 50%;
            top: 45%;
            transform: translate(-50%, -50%);
            background: radial-gradient(circle, rgba(0, 150, 150, 0.45) 0%, rgba(0, 120, 120, 0.25) 25%, rgba(0, 100, 100, 0.10) 45%, rgba(0, 100, 100, 0) 72%);
            pointer-events: none;
            z-index: 0;
        }


    .faq-section {
        width: 100%;
        padding: 5rem 2rem;
        ;
        color: #fff;
        /* No background: inherits the body's background */
        box-sizing: border-box;
    }

    .faq-title {
        margin: 0 0 60px;
        text-align: center;
        font-size: 36px;
        line-height: 1.4;
        font-weight: 500;
        letter-spacing: -0.7px;
    }

    .faq-list {
        width: 100%;
        border-top: 1px solid rgba(255, 255, 255, 0.22);
    }

    .faq-item {
        border-bottom: 1px solid rgba(255, 255, 255, 0.22);
        transition: border-color 0.25s ease;
    }

        .faq-item.active {
            border-bottom-color: var(--primary);
        }

    .faq-question {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        width: 100%;
        padding: 2rem 0;
        border: 0;
        background: transparent;
        color: var(--text);
        font: inherit;
        font-size: 20px;
        line-height: 1.4;
        text-align: left;
        cursor: pointer;
    }

    .faq-icon {
        flex-shrink: 0;
        font-size: 28px;
        line-height: 1;
        font-weight: 300;
        transition: transform 0.25s ease;
    }

    .faq-item {
        border-top: 1px solid var(--text);
    }

    .faq-answer {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.3s ease;
        border-top: 1px solid var(--text);
    }

    .faq-item.active .faq-answer {
        border-top: 1px solid var(--primary);
    }

    .faq-answer p {
        overflow: hidden;
        min-height: 0;
        margin: 0;
        color: rgba(255, 255, 255, 0.8);
        font-size: 20px;
        line-height: 1.3;
    }

    .faq-item.active .faq-answer {
        grid-template-rows: 1fr;
    }

        .faq-item.active .faq-answer p {
            padding: 2rem 0;
        }

    .faq-question:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 4px;
    }

    @@media screen and (min-width: 1024px) and (max-width: 1339px) {
        .ser-img-box {
            padding-left: 2rem;
        }

        .candidate-list-box {
            padding: 0 0rem 3rem;
        }

        .case-desc {
            padding-left: 1rem;
        }
    }

    @@media screen and (min-width: 600px) and (max-width: 1023px) {
        .ser-img-box {
            padding: 0 1REM;
            ;
        }

        .candidate-list-box {
            padding: 0 0rem 3rem;
        }

        .case-desc {
            padding: 1rem 0;
        }
    }

    @@media (max-width: 600px) {
        .banner-text {
            max-width: 400px;
            text-align: left;
        }

        .adv-sec {
            height: 27rem;
        }

        .ser-desc-box {
            padding: 0 2rem;
        }

        .ser-img-box {
            padding: 0 2rem;
        }

        .candidate-list-box {
            padding: 0 0rem 3rem;
        }

        .candidate-col-box {
            margin-bottom: 0px;
        }

        .case-desc {
            padding: 1rem;
        }

        .reviews-carousel-box {
            padding: 1rem 1rem 5rem;
        }

        .faq-section {
            padding: 32px 20px;
        }

        .faq-title {
            margin-bottom: 36px;
            font-size: 28px;
        }

        .faq-question {
            padding: 20px 0;
            font-size: 17px;
        }

        .faq-answer p {
            font-size: 16px;
            line-height: 1.5;
        }

        .faq-item.active .faq-answer p {
            padding: 4px 0 22px;
        }
    }

    @@media (max-width: 430px) {
        .banner-text {
            max-width: 350px;
        }
    }

    @@media (max-width: 380px) {
        .banner-text {
            max-width: 340px;
        }
    }
</style>


@if (data != null)
{
    <section class="banner-section">
        <div class="orb-scene">

            @if (images != null && images.Count > 0 &&
                 !string.IsNullOrWhiteSpace(images[0].ImageUrl))
            {
                <img class="orb orb-1"
                     src="@Url.Content("~/content/uploads/" + images[0].ImageUrl)"
                     alt="@(images[0].AltText ?? "")" />
            }

            @if (images != null && images.Count > 1 &&
                 !string.IsNullOrWhiteSpace(images[1].ImageUrl))
            {
                <img class="orb orb-2"
                     src="@Url.Content("~/content/uploads/" + images[1].ImageUrl)"
                     alt="@(images[1].AltText ?? "")" />
            }

            <div class="banner-text-box">
                <div class="banner-text">

                    @if (buttons != null && buttons.Count > 0)
                    {
                        <a class="btn btn-primary"
                           href="@(buttons[0].Url ?? "#")">
                            <img class="ai-icon"
                                 src="@Url.Content("~/Content/Images/ai-icon.svg")"
                                 alt="" />
                            @(buttons[0].Title ?? "")
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(data.Title))
                    {
                        <h1>@data.Title</h1>
                    }

                    @if (!string.IsNullOrWhiteSpace(data.Description))
                    {
                        <p>@data.Description</p>
                    }

                    @if (buttons != null && buttons.Count > 1)
                    {
                        <div class="banner-btn pt-3">

                            @if (buttons.Count > 1)
                            {
                                <a class="btn btn-secondary"
                                   href="@(buttons[1].Url ?? "#")">
                                    @(buttons[1].Title ?? "")
                                </a>
                            }

                            @if (buttons.Count > 2)
                            {
                                <a class="btn btn-primary"
                                   href="@(buttons[2].Url ?? "#")">
                                    @(buttons[2].Title ?? "")
                                </a>
                            }

                        </div>
                    }

                </div>
            </div>
        </div>
    </section>
}

@{
    var advantageSections = Model?.Sections?
        .Where(x => x != null &&
                    (x.DisplayOrder == 2 || x.DisplayOrder == 3))
        .ToList();
}

@Html.Action("advantages", "Home",
    new { sections = advantageSections })

@if (dataService != null)
{
    var serviceItems = dataService.Items?.Where(i => i != null).ToList()
                       ?? new List<UISectionItemVM>();

    var mainImageUrl = dataService.Images?.FirstOrDefault()?.ImageUrl;

    <section class="home-services-section">
        <div class="home-services-box">
            <div class="home-services-container container">
                <div class="home-services-row row">

                    <div class="col-lg-6 col-md-12 col-12 ser-desc-box">
                        <div class="home-head">
                            @if (!string.IsNullOrWhiteSpace(dataService.SubHeading))
                            {
                                <h3>@dataService.SubHeading</h3>
                            }
                            @if (!string.IsNullOrWhiteSpace(dataService.Heading))
                            {
                                <h2>@dataService.Heading</h2>
                            }
                        </div>
                        @if (serviceItems.Any())
                        {
                            <div class="ser-items">
                                @foreach (var item in serviceItems)
                                {
                                    var iconUrl = item.Images?.FirstOrDefault()?.ImageUrl;

                                    <div class="service-item">
                                        <div class="d-flex">
                                            @if (!string.IsNullOrWhiteSpace(iconUrl))
                                            {
                                                <div class="ser-icon">
                                                    <img src="/Content/Uploads/@iconUrl" alt="@item.Title" />
                                                </div>
                                            }
                                            <div class="ser-desc">
                                                <h3>@item.Title</h3>
                                                <p>@item.Description</p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(mainImageUrl))
                    {
                        <div class="col-lg-6 col-md-12 col-12 ser-img-box">
                            <img src="/Content/Uploads/@mainImageUrl" alt="@dataService.Heading" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}


@if (data5 != null)
{
    var candidateItems = data5.Items?.Where(i => i != null).ToList()
                   ?? new List<UISectionItemVM>();
    <section class="candidate-section">
        <div class="candidate-box">
            <div class="container candidate-container">
                <div class="home-head">
                    <h3>@data5.Title</h3>
                    <h2>@data5.Heading</h2>
                </div>


                <div class="candidate-list-box">
                    <div class="row candidate-row">
                        @foreach (var item in candidateItems)
                        {
                            <div class="col-lg-6 col-md-6 col-12 candidate-col-box">
                                <div class="candidate-item d-flex">
                                    <div class="candidate-icon">
                                        <i class="bi bi-check-circle"></i>
                                    </div>
                                    <div class="candidate-desc">
                                        <p><span class="candidate-icon-bold">@item.Heading</span> @item.Description </p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="candidate-knowmore text-center">
                    <a class="btn btn-secondary" href="@data5.Buttons[0].Url">@data5.Buttons[0].Title</a>
                </div>
            </div>
        </div>
    </section>

}

