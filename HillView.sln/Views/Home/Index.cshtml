@if (data8 != null && reviews != null)
{
    <section class="reviews-section">
        <div class="reviews-box">
            <div class="reviews-container container">
                <div class="reviews-head">
                    <div class="home-head">
                        <h3>@data8.SubHeading</h3>
                        <h2>@data8.Heading</h2>
                    </div>
                </div>
                <div class="reviews-carousel-box">
                    <div class="reviews-items">
                        <div class="owl-carousel owl-theme review-carousel">
                            @foreach (var item in reviews)
                            {
                                <div class="item">
                                    <div class="review-item">
                                        <div class="review-stars">
                                            @{
                                                var rating = Math.Max(0, Math.Min(5, item.Rating));
                                            }
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi @(i <= rating ? "bi-star-fill" : "bi-star")"></i>
                                            }
                                        </div>
                                        <div class="item-review">
                                            <p>"@item.ReviewText"</p>
                                        </div>
                                        <div class="review-name">
                                            @item.ClientName
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}


