
@model IEnumerable<DTOs.ImageVM>

@{
    ViewBag.Title = "Images";
    Layout = "~/Views/Shared/Admin/_AdminLayoutPage.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Images</h2>
            <p class="text-muted mb-0">
                Manage images attached to sections and section items.
            </p>
        </div>

        <a href="@Url.Action("ImageAction", "Admin")"
           class="btn btn-primary">
            <i class="ti ti-plus"></i> Add Image
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Preview</th>
                            <th>Alt Text</th>
                            <th>Caption</th>
                            <th>Image Type</th>
                            <th>Parent</th>
                            <th>Display Order</th>
                            <th>Status</th>
                            <th>Created At</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var image in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(image.ImageUrl))
                                        {
                                            <img src="@Url.Content(image.ImageUrl)"
                                                 alt="@(image.AltText ?? "Image preview")"
                                                 style="width:80px;height:60px;object-fit:cover;"
                                                 class="rounded border" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">No image</span>
                                        }
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(image.AltText)
                                            ? "-"
                                            : image.AltText)
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(image.Caption)
                                            ? "-"
                                            : image.Caption)
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(image.ImageType)
                                            ? "-"
                                            : image.ImageType)
                                    </td>

                                    <td>
                                        @if (image.SectionId.HasValue)
                                        {
                                            <span class="badge bg-info">
                                                Section
                                            </span>
                                        }
                                        else if (image.SectionItemId.HasValue)
                                        {
                                            <span class="badge bg-primary">
                                                Section Item
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Unassigned</span>
                                        }
                                    </td>

                                    <td>@image.DisplayOrder</td>

                                    <td>
                                        @if (image.Status)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @(image.CreatedAt.ToLocalTime()
                                            .ToString("dd MMM yyyy"))
                                    </td>

                                    <td class="text-end">
                                        <a href="@Url.Action(
                                            "ImageAction",
                                            "Admin",
                                            new { id = image.Id })"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="ti ti-edit"></i> Edit
                                        </a>

                                        @using (Html.BeginForm(
                                            "DeleteImage",
                                            "Admin",
                                            new { id = image.Id },
                                            FormMethod.Post,
                                            new { @class = "d-inline delete-image-form" }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                <i class="ti ti-trash"></i> Delete
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9"
                                    class="text-center text-muted py-4">
                                    No images found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $(".delete-image-form").on("submit", function (e) {
                if (!confirm(
                    "Are you sure you want to delete this image record?")) {
                    e.preventDefault();
                }
            });
        });
    </script>
}
