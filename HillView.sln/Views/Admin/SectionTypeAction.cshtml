
@model DTOs.SectionTypeVM

@{
    bool isEdit = Model != null && Model.Id > 0;

    ViewBag.Title = isEdit
        ? "Edit Section Type"
        : "Add Section Type";

    Layout = "~/Views/Shared/Admin/_AdminLayoutPage.cshtml";
}

<div class="container-fluid">
    <div class="row mb-3 align-items-center">
        <div class="col-md-8">
            <h2>@ViewBag.Title</h2>
            <p class="text-muted">
                Define a reusable section type for your website.
                Fields marked with * are required.
            </p>
        </div>

        <div class="col-md-4 text-right">
            <a href="@Url.Action("SectionTypes", "Admin")"
               class="btn btn-secondary">
                Back to Section Types
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">

            @using (Html.BeginForm(
                "SectionTypeAction",
                "Admin",
                FormMethod.Post,
                new { id = "sectionTypeForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)

                @Html.ValidationSummary(
                    false,
                    "",
                    new { @class = "alert alert-danger" })

                <div class="form-group">
                    @Html.LabelFor(m => m.Name, new { @class = "form-label" })

                    @Html.TextBoxFor(m => m.Name, new
                    {
                        @class = "form-control",
                        placeholder = "Example: Hero",
                        maxlength = "100"
                    })

                    @Html.ValidationMessageFor(
                        m => m.Name,
                        "",
                        new { @class = "text-danger" })

                    <small class="form-text text-muted">
                        Use a stable internal name, such as Hero,
                        FeatureCards, Team, or Statistics.
                    </small>
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Title, new { @class = "form-label" })

                    @Html.TextBoxFor(m => m.Title, new
                    {
                        @class = "form-control",
                        placeholder = "Example: Hero Banner",
                        maxlength = "200"
                    })

                    @Html.ValidationMessageFor(
                        m => m.Title,
                        "",
                        new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Description, new { @class = "form-label" })

                    @Html.TextAreaFor(m => m.Description, new
                    {
                        @class = "form-control",
                        rows = "3",
                        maxlength = "500",
                        placeholder = "Explain when this section type should be used."
                    })

                    @Html.ValidationMessageFor(
                        m => m.Description,
                        "",
                        new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.DisplayOrder, new { @class = "form-label" })

                    @Html.TextBoxFor(m => m.DisplayOrder, new
                    {
                        @class = "form-control",
                        type = "number",
                        min = "0"
                    })

                    @Html.ValidationMessageFor(
                        m => m.DisplayOrder,
                        "",
                        new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    <div class="custom-control custom-checkbox">
                        @Html.CheckBoxFor(m => m.Status, new
                        {
                            @class = "custom-control-input",
                            id = "sectionTypeStatus"
                        })

                        <label class="custom-control-label"
                               for="sectionTypeStatus">
                            Active
                        </label>
                    </div>

                    <small class="form-text text-muted">
                        Inactive types should not be available when creating
                        new sections.
                    </small>
                </div>

                <hr />

                <button type="submit" class="btn btn-primary">
                    Save Section Type
                </button>

                <a href="@Url.Action("SectionTypes", "Admin")"
                   class="btn btn-secondary">
                    Cancel
                </a>
            }
        </div>
    </div>
</div>

