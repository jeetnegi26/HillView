
@model IEnumerable<DTOs.SectionTypeVM>

@{
    ViewBag.Title = "Manage Section Types";
    Layout = "~/Views/Shared/Admin/_AdminLayoutPage.cshtml";
}

<div class="container-fluid">
    <div class="row mb-3 align-items-center">
        <div class="col-md-8">
            <h2>Manage Section Types</h2>
            <p class="text-muted">
                Manage the reusable section types available in your CMS.
            </p>
        </div>

        <div class="col-md-4 text-right">
            <a href="@Url.Action("SectionTypeAction", "Admin")"
               class="btn btn-primary">
                <i class="fa fa-plus"></i> Add Section Type
            </a>
        </div>
    </div>

    @if (TempData["SectionTypeSuccess"] != null)
    {
        <div class="alert alert-success">
            @TempData["SectionTypeSuccess"]
        </div>
    }

    @if (TempData["SectionTypeError"] != null)
    {
        <div class="alert alert-danger">
            @TempData["SectionTypeError"]
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Display Title</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Display Order</th>
                            <th style="width: 170px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Name</td>
                                    <td>@item.Title</td>
                                    <td>@item.Description</td>
                                    <td>
                                        @if (item.Status)
                                        {
                                            <span class="badge badge-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">
                                                Inactive
                                            </span>
                                        }
                                    </td>
                                    <td>@item.DisplayOrder</td>
                                    <td>
                                        <a href="@Url.Action(
                                            "SectionTypeAction",
                                            "Admin",
                                            new { id = item.Id })"
                                           class="btn btn-sm btn-info">
                                            Edit
                                        </a>

                                        @using (Html.BeginForm(
                                            "DeleteSectionType",
                                            "Admin",
                                            new { id = item.Id },
                                            FormMethod.Post,
                                            new { @class = "d-inline delete-section-type-form" }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger">
                                                Delete
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">
                                    No section types found. Click Add Section Type to create one.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(function () {
            $('.delete-section-type-form').on('submit', function (e) {
                if (!confirm(
                    'Are you sure you want to delete this section type?')) {
                    e.preventDefault();
                }
            });
        });
    </script>
}
