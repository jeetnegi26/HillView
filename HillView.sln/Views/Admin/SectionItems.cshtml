
@model IEnumerable<DTOs.SectionItemVM>

@{
    ViewBag.Title = "Section Items";
    Layout = "~/Views/Shared/Admin/_AdminLayoutPage.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Section Items</h2>
            <p class="text-muted mb-0">
                Manage content items belonging to website sections.
            </p>
        </div>

        <a href="@Url.Action("SectionItemAction", "Admin")"
           class="btn btn-primary">
            <i class="ti ti-plus"></i> Add Section Item
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Heading</th>
                            <th>Value</th>
                            <th>Display Order</th>
                            <th>Status</th>
                            <th>Created At</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.Title)
                                            ? "-"
                                            : item.Title)
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.Heading)
                                            ? "-"
                                            : item.Heading)
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.Value)
                                            ? "-"
                                            : item.Value)
                                    </td>

                                    <td>@item.DisplayOrder</td>

                                    <td>
                                        @if (item.Status)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        @(item.CreatedAt.ToLocalTime()
                                            .ToString("dd MMM yyyy"))
                                    </td>

                                    <td class="text-end">
                                        <a href="@Url.Action(
                                            "SectionItemAction",
                                            "Admin",
                                            new { id = item.Id })"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="ti ti-edit"></i> Edit
                                        </a>

                                        @using (Html.BeginForm(
                                            "DeleteSectionItem",
                                            "Admin",
                                            new { id = item.Id },
                                            FormMethod.Post,
                                            new { @class = "d-inline delete-section-item-form" }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                <i class="ti ti-trash"></i> Delete
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    No section items found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $(".delete-section-item-form").on("submit", function (e) {
                if (!confirm("Are you sure you want to delete this section item?")) {
                    e.preventDefault();
                }
            });
        });
    </script>
}
