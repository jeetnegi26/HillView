@model IEnumerable<DTOs.SectionVM>

@{
    ViewBag.Title = "Sections";
    Layout = "~/Views/Shared/Admin/_AdminLayoutPage.cshtml";
}


<style>
    .section-actions {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }
    .section-actions-row {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 6px;
    }
    .section-actions-row form {
        margin: 0;
    }
    .section-actions-row .btn {
        white-space: nowrap;
    }
</style>

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Sections</h2>
            <p class="text-muted mb-0">
                Manage reusable website content sections.
            </p>
        </div>

        <a href="@Url.Action("SectionAction", "Admin")"
           class="btn btn-primary">
            <i class="ti ti-plus"></i> Add Section
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Section Title</th>
                            <th>Heading</th>
                            <th>Internal Name</th>
                            <th>Status</th>
                            <th>Created At</th>
                            <th class="text-center" style="width: 230px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var section in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@(section.Title)</strong>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(section.Heading)
                                            ? "-"
                                            : section.Heading)
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(section.InternalName)
                                            ? "-"
                                            : section.InternalName)
                                    </td>

                                    <td>
                                        @if (section.Status)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>

                                    <td>
                                        @(section.CreatedAt.ToLocalTime().ToString("dd MMM yyyy"))
                                    </td>

                                    <td class="text-center">
                                        <div class="section-actions">

                                            <div class="section-actions-row">
                                                <a href="@Url.Action("SectionAction", "Admin", new { id = section.Id })"
                                                   class="btn btn-sm btn-primary">
                                                    Edit
                                                </a>

                                                @using (Html.BeginForm(
                                                    "DeleteSection",
                                                    "Admin",
                                                    new { id = section.Id },
                                                    FormMethod.Post,
                                                    new { @class = "delete-section-form" }))
                                                {
                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger">
                                                        Delete
                                                    </button>
                                                }
                                                <a href="@Url.Action("SectionItems", "Admin", new { sectionId = section.Id })"
                                                   class="btn btn-sm btn-indigo">
                                                    <i class="ti ti-list" style="font-size: 1.3em !important"></i> Section Items
                                                </a>
                                            </div>

                                            <div class="section-actions-row">
                                                <a href="@Url.Action("ImageAction", "Admin", new { sectionId = section.Id })"
                                                   class="btn btn-sm btn-secondary">
                                                    <i class="ti ti-photo" style="font-size: 1.3em !important"></i> Add Image
                                                </a>

                                                <a href="@Url.Action("ButtonAction", "Admin", new { sectionId = section.Id })"
                                                   class="btn btn-sm btn-outline-info">
                                                    <i class="ti ti-click" style="font-size: 1.3em !important"></i> Add Button
                                                </a>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    No sections found. Click
                                    <strong>Add Section</strong> to create one.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $(".delete-section-form").on("submit", function (e) {
                if (!confirm(
                    "Are you sure you want to delete this section? " +
                    "Sections assigned to pages or containing related records " +
                    "may need to be unassigned first."
                )) {
                    e.preventDefault();
                }
            });
        });
    </script>
}