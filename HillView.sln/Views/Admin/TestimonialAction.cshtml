@model DTOs.TestimonialVM

@{
    ViewBag.Title = Model.Id == Guid.Empty ? "Add Testimonial" : "Edit Testimonial";
    Layout = "~/Views/Shared/Admin/_AdminLayoutPage.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>@ViewBag.Title</h2>
            <p class="text-muted mb-0">Manage customer testimonials.</p>
        </div>

        <a href="@Url.Action("Testimonials", "Admin")"
           class="btn btn-dark-light">
            Back to Testimonials
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            @using (Html.BeginForm(
                "TestimonialAction",
                "Admin",
                FormMethod.Post,
                new { id = "testimonialForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)

                if (!ViewData.ModelState.IsValid)
                {
                    @Html.ValidationSummary(
                        false,
                        "",
                        new { @class = "alert alert-danger" })
                }

                <div class="row">
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.ClientName,
                            new { @class = "form-label" })
                        <span class="text-danger">*required</span>

                        @Html.TextBoxFor(m => m.ClientName,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Enter client name",
                                maxlength = "150"
                            })

                        @Html.ValidationMessageFor(m => m.ClientName,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.Rating,
                            new { @class = "form-label" })
                        <span class="text-danger">*required</span>

                        @Html.DropDownListFor(
                            m => m.Rating,
                            new SelectList(
                                new[]
                                {
                                    new { Value = 5, Text = "5 Stars" },
                                    new { Value = 4, Text = "4 Stars" },
                                    new { Value = 3, Text = "3 Stars" },
                                    new { Value = 2, Text = "2 Stars" },
                                    new { Value = 1, Text = "1 Star" }
                                },
                                "Value",
                                "Text",
                                Model.Rating),
                            new { @class = "form-select" })

                        @Html.ValidationMessageFor(m => m.Rating,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="col-12 mb-3">
                        @Html.LabelFor(m => m.ReviewText,
                            new { @class = "form-label" })
                        <span class="text-danger">*required</span>

                        @Html.TextAreaFor(m => m.ReviewText,
                            new
                            {
                                @class = "form-control",
                                rows = 5,
                                placeholder = "Enter customer review",
                                maxlength = "1000"
                            })

                        @Html.ValidationMessageFor(m => m.ReviewText,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.DisplayOrder,
                            new { @class = "form-label" })

                        @Html.TextBoxFor(m => m.DisplayOrder,
                            new
                            {
                                @class = "form-control",
                                type = "number",
                                min = "0"
                            })

                        @Html.ValidationMessageFor(m => m.DisplayOrder,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="col-12 mb-4">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.Status,
                                new { @class = "form-check-input" })

                            @Html.LabelFor(m => m.Status,
                                new { @class = "form-check-label" })
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-indigo">
                        Save Testimonial
                    </button>

                    <a href="@Url.Action("Testimonials", "Admin")"
                       class="btn btn-outline-danger">
                        Cancel
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $("#testimonialForm").on("submit", function () {
                if ($(this).valid()) {
                    $(this).find('button[type="submit"]')
                        .prop("disabled", true);
                }
            });
        });
    </script>
}
