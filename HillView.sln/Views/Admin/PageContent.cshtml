                var $altInput = $("<input>")
                    .attr("type", "text")
                    .attr("maxlength", "500")
                    .addClass("form-control edit-section-image-alt")
                    .val(image.altText || "");

                var $captionLabel = $("<label>").addClass("mt-2").text("Caption");
                var $captionInput = $("<input>")
                    .attr("type", "text")
                    .attr("maxlength", "500")
                    .addClass("form-control edit-section-image-caption")
                    .val(image.caption || "");

                var $orderLabel = $("<label>").addClass("mt-2").text("Display Order");
                var $orderInput = $("<input>")
                    .attr("type", "number")
                    .attr("min", "0")
                    .addClass("form-control edit-section-image-order")
                    .val(image.displayOrder || 0);

                var $statusInput = $("<input>")
                    .attr("type", "checkbox")
                    .addClass("form-check-input edit-section-image-status")
                    .prop("checked", image.status);

                var $statusContainer = $("<div>")
                    .addClass("form-check mt-2")
                    .append(
                        $statusInput,
                        " ",
                        $("<label>").addClass("form-check-label").text("Active")
                    );

                var $saveButton = $("<button>")
                    .attr("type", "button")
                    .addClass("btn btn-primary btn-sm mt-3 save-section-image-edit")
                    .text("Save Changes");

                var $cancelButton = $("<button>")
                    .attr("type", "button")
                    .addClass("btn btn-secondary btn-sm mt-3 ml-2 cancel-section-image-edit")
