
@model IEnumerable<DTOs.PageSectionVM>

@{
    ViewBag.Title = "Edit Page Content";
    Layout = "~/Views/Shared/Admin/_AdminLayoutPage.cshtml";
    var pageId = (Guid)ViewBag.PageId;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Edit Page Content</h2>
            <p class="text-muted mb-0">
                Page: <strong>@ViewBag.PageTitle</strong>
            </p>
        </div>

        <a href="@Url.Action("Pages", "Admin")"
           class="btn btn-secondary">
            Back to Pages
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="d-flex justify-content-end mb-3">
        <a href="@Url.Action("PageSectionAction", "Admin")"
           class="btn btn-primary">
            <i class="fa fa-plus"></i> Assign Existing Section
        </a>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Page Sections</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th style="width: 70px;">Order</th>
                            <th>Section</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th style="width: 180px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.DisplayOrder</td>
                                    <td>@item.SectionTitle</td>
                                    <td>
                                        @if (item.Status)
                                        {
                                            <span class="badge badge-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">
                                                Inactive
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @item.CreatedAt.ToString("dd MMM yyyy")
                                    </td>
                                    <td>
                                        <button type="button"
                                                class="btn btn-sm btn-primary edit-section-btn"
                                                data-section-id="@item.SectionId"
                                                data-section-title="@item.SectionTitle">
                                            Edit Content
                                        </button>

                                        <a href="@Url.Action(
        "PageSectionAction",
        "Admin",
        new { id = item.Id })"
                                           class="btn btn-sm btn-outline-secondary">
                                            Assignment
                                        </a>

                                        <button type="button"
                                                class="btn btn-sm btn-info manage-section-items-btn"
                                                data-section-id="@item.SectionId"
                                                data-section-title="@item.SectionTitle">
                                            Manage Cards
                                        </button>

                                        @* Remove section from this page only *@
                                        @using (Html.BeginForm(
                                            "DeletePageSection",
                                            "Admin",
                                            new { id = item.Id },
                                            FormMethod.Post,
                                            new { style = "display:inline;" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="pageId" value="@pageId" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-warning"
                                                    onclick="return confirm('Remove this section from the current page?');">
                                                <i class="fa fa-unlink"></i> Remove
                                            </button>
                                        }

                                        @* Permanently delete the actual section *@
                                        @using (Html.BeginForm(
                                            "DeleteSection",
                                            "Admin",
                                            new { id = item.SectionId, pageId = pageId },
                                            FormMethod.Post,
                                            new { style = "display:inline;" }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="return confirm('WARNING: Permanently delete this section? This may affect other pages using it. This action cannot be undone.');">
                                                <i class="fa fa-trash"></i> Permanent Delete
                                            </button>
                                        }

                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center">
                                    No sections have been assigned to this page yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card mt-4" id="sectionEditor" style="display:none;">
        <div class="card-header">
            <h5 class="mb-0" id="editorTitle">Edit Section Content</h5>
        </div>

        <div class="card-body">
            <div id="editorLoading" class="text-muted" style="display:none;">
                Loading section...
            </div>

            <div id="editorError" class="alert alert-danger"
                 style="display:none;"></div>

            <div id="editorFields" style="display:none;">
                <input type="hidden" id="editSectionId" />

                <div class="form-group">
                    <label for="editHeading">Heading</label>
                    <input type="text" id="editHeading"
                           class="form-control" maxlength="200" />
                </div>

                <div class="form-group">
                    <label for="editSubHeading">Subheading</label>
                    <input type="text" id="editSubHeading"
                           class="form-control" maxlength="200" />
                </div>

                <div class="form-group">
                    <label for="editDescription">Description</label>
                    <textarea id="editDescription"
                              class="form-control" rows="5"></textarea>
                </div>

                <div class="form-group">
                    <label for="editBackgroundColor">Background Color</label>
                    <input type="text" id="editBackgroundColor"
                           class="form-control" maxlength="50"
                           placeholder="#13092F" />
                </div>

                <div class="form-group">
                    <label for="editCssClass">CSS Class</label>
                    <input type="text" id="editCssClass"
                           class="form-control" maxlength="200" />
                </div>

                <button type="button" id="saveSectionContent"
                        class="btn btn-primary">
                    Save Changes
                </button>

                <button type="button" id="cancelSectionEdit"
                        class="btn btn-secondary">
                    Cancel
                </button>
            </div>

            <!-- Section Image Management -->
            <hr class="my-4" />

            <div id="sectionImageManager" style="display:none;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Section Images</h5>
                    <button type="button" id="loadSectionImages"
                            class="btn btn-outline-primary btn-sm">
                        Load Images
                    </button>
                </div>

                <div id="sectionImagesError"
                     class="alert alert-danger"
                     style="display:none;"></div>

                <div id="sectionImagesLoading"
                     class="text-muted mb-2"
                     style="display:none;">
                    Loading section images...
                </div>

                <div id="sectionImagesList"></div>

                <p id="noSectionImages"
                   class="text-muted"
                   style="display:none;">
                    No images have been added to this section yet.
                </p>

                <hr />

                <h6>Upload Section Image</h6>

                <div class="form-group">
                    <label for="sectionImageFile">Choose Image</label>
                    <input type="file"
                           id="sectionImageFile"
                           class="form-control-file"
                           accept="image/jpeg,image/png,image/gif,image/webp" />
                </div>

                <div class="form-group">
                    <label for="sectionImageAlt">Alt Text</label>
                    <input type="text"
                           id="sectionImageAlt"
                           class="form-control"
                           maxlength="500"
                           placeholder="Describe the image" />
                </div>

                <div class="form-group">
                    <label for="sectionImageCaption">Caption</label>
                    <input type="text"
                           id="sectionImageCaption"
                           class="form-control"
                           maxlength="500"
                           placeholder="Optional caption" />
                </div>

                <button type="button" id="uploadSectionImage"
                        class="btn btn-success btn-sm">
                    Upload Image
                </button>

                <span id="sectionImageUploadMessage" class="ml-2"></span>
            </div>


            <div id="sectionButtonManager" style="display:none;">
                <hr />

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5>Section Buttons</h5>
                    <button type="button" id="loadSectionButtons"
                            class="btn btn-outline-primary btn-sm">
                        Load Buttons
                    </button>
                </div>

                <div id="sectionButtonsError"
                     class="alert alert-danger"
                     style="display:none;"></div>

                <div id="sectionButtonsLoading" style="display:none;">
                    Loading section buttons...
                </div>

                <div id="sectionButtonsList"></div>

                <p id="noSectionButtons" class="text-muted" style="display:none;">
                    No buttons have been added to this section yet.
                </p>

                <hr />

                <h6 id="sectionButtonFormTitle">Add Section Button</h6>

                <input type="hidden" id="sectionButtonId" />

                <div class="form-group">
                    <label for="sectionButtonTitle">Button Text</label>
                    <input type="text" id="sectionButtonTitle"
                           class="form-control" maxlength="200"
                           placeholder="e.g. Learn More" />
                </div>

                <div class="form-group">
                    <label for="sectionButtonUrl">URL</label>
                    <input type="text" id="sectionButtonUrl"
                           class="form-control" maxlength="1000"
                           placeholder="e.g. /About or https://example.com" />
                </div>

                <div class="form-group">
                    <label for="sectionButtonTarget">Link Target</label>
                    <select id="sectionButtonTarget" class="form-control">
                        <option value="_self">Same tab</option>
                        <option value="_blank">New tab</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="sectionButtonCssClass">CSS Class</label>
                    <input type="text" id="sectionButtonCssClass"
                           class="form-control" maxlength="200"
                           placeholder="e.g. btn btn-primary" />
                </div>

                <div class="form-group">
                    <label for="sectionButtonType">Button Type</label>
                    <input type="text" id="sectionButtonType"
                           class="form-control" maxlength="100"
                           placeholder="e.g. Primary or Secondary" />
                </div>

                <div class="form-group">
                    <label for="sectionButtonDisplayOrder">Display Order</label>
                    <input type="number" id="sectionButtonDisplayOrder"
                           class="form-control" min="0" value="1" />
                </div>

                <div class="form-check mb-3">
                    <input type="checkbox" id="sectionButtonStatus"
                           class="form-check-input" checked />
                    <label class="form-check-label" for="sectionButtonStatus">
                        Active
                    </label>
                </div>

                <button type="button" id="saveSectionButton"
                        class="btn btn-primary">
                    Save Button
                </button>

                <button type="button" id="cancelSectionButtonEdit"
                        class="btn btn-secondary">
                    Clear Form
                </button>

                <span id="sectionButtonSaveMessage" class="ml-2"></span>
            </div>

        </div>
    </div>


    <div class="card mt-4" id="sectionItemsEditor" style="display:none;">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0" id="itemsEditorTitle">Manage Section Items</h5>

            <button type="button" class="btn btn-sm btn-primary"
                    id="addSectionItem">
                <i class="fa fa-plus"></i> Add Card
            </button>
        </div>

        <div class="card-body">
            <div id="itemsEditorError" class="alert alert-danger"
                 style="display:none;"></div>

            <div id="sectionItemsContainer"></div>

            <div id="cardButtonManager" style="display:none;">
                <hr />
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5>Card Buttons</h5>
                    <button type="button" id="loadCardButtons"
                            class="btn btn-outline-primary btn-sm">
                        Load Buttons
                    </button>
                </div>

                <div id="cardButtonsError" class="alert alert-danger"
                     style="display:none;"></div>

                <div id="cardButtonsLoading" style="display:none;">
                    Loading card buttons...
                </div>

                <div id="cardButtonsList"></div>

                <p id="noCardButtons" class="text-muted" style="display:none;">
                    No buttons have been added to this card yet.
                </p>

                <hr />
                <h6 id="cardButtonFormTitle">Add Card Button</h6>

                <input type="hidden" id="cardButtonId" />
                <input type="hidden" id="cardButtonSectionItemId" />

                <div class="form-group">
                    <label for="cardButtonTitle">Button Text</label>
                    <input type="text" id="cardButtonTitle"
                           class="form-control" maxlength="200"
                           placeholder="e.g. View Details" />
                </div>

                <div class="form-group">
                    <label for="cardButtonUrl">URL</label>
                    <input type="text" id="cardButtonUrl"
                           class="form-control" maxlength="1000"
                           placeholder="e.g. /Property/Details/123" />
                </div>

                <div class="form-group">
                    <label for="cardButtonTarget">Link Target</label>
                    <select id="cardButtonTarget" class="form-control">
                        <option value="_self">Same tab</option>
                        <option value="_blank">New tab</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="cardButtonCssClass">CSS Class</label>
                    <input type="text" id="cardButtonCssClass"
                           class="form-control" maxlength="200"
                           placeholder="e.g. btn btn-primary" />
                </div>

                <div class="form-group">
                    <label for="cardButtonType">Button Type</label>
                    <input type="text" id="cardButtonType"
                           class="form-control" maxlength="100"
                           placeholder="e.g. Primary or Secondary" />
                </div>

                <div class="form-group">
                    <label for="cardButtonDisplayOrder">Display Order</label>
                    <input type="number" id="cardButtonDisplayOrder"
                           class="form-control" min="0" value="1" />
                </div>

                <div class="form-check mb-3">
                    <input type="checkbox" id="cardButtonStatus"
                           class="form-check-input" checked />
                    <label class="form-check-label" for="cardButtonStatus">
                        Active
                    </label>
                </div>

                <button type="button" id="saveCardButton"
                        class="btn btn-primary">
                    Save Button
                </button>

                <button type="button" id="cancelCardButtonEdit"
                        class="btn btn-secondary">
                    Clear Form
                </button>

                <span id="cardButtonSaveMessage" class="ml-2"></span>
            </div>


            <p id="noSectionItems" class="text-muted"
               style="display:none;">
                No cards have been added to this section yet.
            </p>
        </div>
    </div>


    <div id="sectionAntiForgeryToken" style="display:none;">
        @Html.AntiForgeryToken()
    </div>

</div>
<script>

$(document).ready(function() {
    var currentItemsSectionId = null;

    $(".edit-section-btn").on("click", function () {
        var sectionId = $(this).data("section-id");
        var sectionTitle = $(this).data("section-title");


        $("#sectionImageManager").hide();
        $("#sectionButtonManager").hide();
        $("#sectionImagesList").empty();
        $("#sectionImagesError").hide();
        $("#sectionImagesLoading").hide();
        $("#noSectionImages").hide();
        $("#sectionImageUploadMessage").text("");

        $("#sectionImageFile").val("");
        $("#sectionImageAlt").val("");
        $("#sectionImageCaption").val("");


        $("#sectionButtonId").val("");
        $("#sectionButtonTitle").val("");
        $("#sectionButtonUrl").val("");
        $("#sectionButtonTarget").val("_self");
        $("#sectionButtonCssClass").val("");
        $("#sectionButtonType").val("");
        $("#sectionButtonDisplayOrder").val("1");
        $("#sectionButtonStatus").prop("checked", true);
        $("#sectionButtonFormTitle").text("Add Section Button");
        $("#sectionButtonSaveMessage").text("");
        $("#sectionButtonsList").empty();
        $("#noSectionButtons").hide();
        $("#sectionButtonsError").hide();



        $("#sectionEditor").show();
        $("#editorTitle").text("Edit Content: " + sectionTitle);
        $("#editorFields").hide();
        $("#editorError").hide();
        $("#editorLoading").show().text("Loading section...");

        $.ajax({
            url: '@Url.Action("GetSectionContent", "Admin")',
            type: "GET",
            data: { id: sectionId },
            dataType: "json",

            success: function (response) {
                $("#editorLoading").hide();

                if (!response.success) {
                    $("#editorError")
                        .text(response.message || "Unable to load section.")
                        .show();
                    return;
                }

                var section = response.data;

                $("#editSectionId").val(section.id);
                $("#editHeading").val(section.heading || "");
                $("#editSubHeading").val(section.subHeading || "");
                $("#editDescription").val(section.description || "");
                $("#editBackgroundColor").val(section.backgroundColor || "");
                $("#editCssClass").val(section.cssClass || "");

                $("#editorFields").show();

                // Show image management for the selected section.
                $("#sectionImageManager").show();

                // Show button management for the selected section.
                $("#sectionButtonManager").show(); // ADD THIS LINE


                $("html, body").animate({
                    scrollTop: $("#sectionEditor").offset().top - 30
                }, 300);
            },

            error: function () {
                $("#editorLoading").hide();
                $("#editorError")
                    .text("An error occurred while loading section content.")
                    .show();
            }
        });
    });


    $("#cancelSectionEdit").on("click", function () {
        $("#sectionEditor").hide();
        $("#editorError").hide();
        $("#editorFields").hide();
        $("#sectionImageManager").hide();
        $("#sectionButtonManager").hide();
        $("#editSectionId").val("");
    });


$("#saveSectionContent").on("click", function () {
    var button = $(this);

    var model = {
        Id: $("#editSectionId").val(),
        Heading: $("#editHeading").val(),
        SubHeading: $("#editSubHeading").val(),
        Description: $("#editDescription").val(),
        BackgroundColor: $("#editBackgroundColor").val(),
        CssClass: $("#editCssClass").val()
    };

    var token = $("#sectionAntiForgeryToken input[name='__RequestVerificationToken']")
        .val();

    button.prop("disabled", true).text("Saving...");
    model.__RequestVerificationToken = token;
    $.ajax({
        url: '@Url.Action("SaveSectionContent", "Admin")',
        type: "POST",
        data: model,
        headers: {
            "RequestVerificationToken": token
        },
        success: function (response) {
            if (response.success) {
                alert(response.message);
            } else {
                alert(response.message || "Unable to save changes.");
            }
        },
        error: function (xhr) {
            alert("Save failed. Please check the browser console and server logs.");
            console.error(xhr.responseText);
        },
        complete: function () {
            button.prop("disabled", false).text("Save Changes");
        }
    });
});




$(".manage-section-items-btn").on("click", function () {
    var sectionId = $(this).data("section-id");
    var sectionTitle = $(this).data("section-title");

    currentItemsSectionId = sectionId;

    $("#sectionItemsEditor").show();
    $("#itemsEditorTitle").text("Manage Cards: " + sectionTitle);
    $("#sectionItemsContainer").empty();
    $("#itemsEditorError").hide();
    $("#noSectionItems").hide();

    $.ajax({
        url: '@Url.Action("GetSectionItemsContent", "Admin")',
        type: "GET",
        data: { sectionId: sectionId },
        dataType: "json",

        success: function (response) {
            if (!response.success) {
                $("#itemsEditorError")
                    .text(response.message || "Unable to load cards.")
                    .show();
                return;
            }

            var items = response.data || [];

            if (items.length === 0) {
                $("#noSectionItems").show();
            }

            $.each(items, function (index, item) {
                renderSectionItem(item);
            });

            $("html, body").animate({
                scrollTop: $("#sectionItemsEditor").offset().top - 30
            }, 300);
        },

        error: function (xhr) {
            $("#itemsEditorError")
                .text("Unable to load cards. Check the browser console.")
                .show();

            console.error(xhr.responseText);
        }
    });
});


    function renderSectionItem(item) {
        var html = `
    <div class="border rounded p-3 mb-3 section-item-card"
         data-item-id="${item.id || ""}">

        <input type="hidden" class="item-id"
               value="${item.id || ""}" />

        <div class="form-group">
            <label>Title *</label>
            <input type="text" class="form-control item-title"
                   maxlength="200"
                   value="${escapeHtml(item.title || "")}" />
        </div>

        <div class="form-group">
            <label>Heading</label>
            <input type="text" class="form-control item-heading"
                   maxlength="200"
                   value="${escapeHtml(item.heading || "")}" />
        </div>

        <div class="form-group">
            <label>Description</label>
            <textarea class="form-control item-description"
                      rows="3">${escapeHtml(item.description || "")}</textarea>
        </div>

        <div class="form-group">
            <label>Display Order</label>
            <input type="number" min="0"
                   class="form-control item-display-order"
                   value="${item.displayOrder || 0}" />
        </div>

        <div class="form-check mb-3">
            <input type="checkbox"
                   class="form-check-input item-status"
                   ${item.status ? "checked" : ""} />
            <label class="form-check-label">Active</label>
        </div>

        <div class="d-flex align-items-center flex-wrap">
            <button type="button"
                    class="btn btn-primary btn-sm save-section-item">
                Save Card
            </button>

            <button type="button"
                    class="btn btn-danger btn-sm delete-section-item ml-2">
                Delete Card
            </button>

            <span class="item-save-message ml-2"></span>
        </div>

        <!-- NEW: Image management area -->
        <hr class="my-3" />

        <div class="section-item-image-manager mt-3">

<div class="d-flex justify-content-between align-items-center mb-2 flex-wrap">
    <h6 class="mb-0">Card Images</h6>

    <div>
        <button type="button"
                class="btn btn-outline-primary btn-sm manage-card-images">
            Manage Images
        </button>

        <button type="button"
                class="btn btn-outline-success btn-sm manage-card-buttons ml-2">
            Manage Buttons
        </button>
    </div>
</div>


            <div class="card-images-container" style="display: none;">
                <div class="card-images-loading text-muted small"
                     style="display: none;">
                    Loading images...
                </div>

                <div class="card-images-list"></div>

<div class="card-image-upload mt-3">
    <div class="form-group">
        <label>Choose Image</label>
        <input type="file"
               class="form-control-file card-image-file"
               accept="image/jpeg,image/png,image/gif,image/webp" />
    </div>

    <div class="form-group">
        <label>Alt Text</label>
        <input type="text"
               class="form-control card-image-alt"
               maxlength="500"
               placeholder="Describe the image" />
    </div>

    <div class="form-group">
        <label>Caption</label>
        <input type="text"
               class="form-control card-image-caption"
               maxlength="500"
               placeholder="Optional image caption" />
    </div>

    <button type="button"
            class="btn btn-success btn-sm upload-card-image">
        Upload Image
    </button>

    <span class="card-image-upload-message ml-2"></span>
</div>


                <div class="card-images-empty text-muted small"
                     style="display: none;">
                    No images have been added to this card yet.
                </div>

                <div class="card-images-error text-danger small"
                     style="display: none;"></div>
            </div>
        </div>

    </div>`;

        $("#sectionItemsContainer").append(html);
    }


    $("#sectionItemsContainer").on("click", ".save-section-item", function () {
    var $button = $(this);
    var $card = $button.closest(".section-item-card");
    var $message = $card.find(".item-save-message");

    var title = $card.find(".item-title").val().trim();

    if (!title) {
        $message.text("Title is required.")
                .css("color", "red");
        return;
    }

    if (!currentItemsSectionId) {
        $message.text("Please select a section first.")
                .css("color", "red");
        return;
    }

    var token = $("#sectionAntiForgeryToken")
        .find('input[name="__RequestVerificationToken"]')
        .val();

    var model = {
        Id: $card.find(".item-id").val() || "00000000-0000-0000-0000-000000000000",
        SectionId: currentItemsSectionId,
        Title: title,
        Heading: $card.find(".item-heading").val(),
        Description: $card.find(".item-description").val(),
        DisplayOrder: parseInt($card.find(".item-display-order").val(), 10) || 0,
        Status: $card.find(".item-status").is(":checked"),
        __RequestVerificationToken: token
    };

    $button.prop("disabled", true).text("Saving...");
    $message.text("");

    $.ajax({
        url: '@Url.Action("SaveSectionItemContent", "Admin")',
        type: "POST",
        data: model,
        success: function (response) {
            if (response.success) {
                $card.find(".item-id").val(response.id);
                $card.attr("data-item-id", response.id);
                $message.text(response.message)
                        .css("color", "green");

                // Update the card ID after inserting a new card.
                // The server endpoint must return the saved ID for new cards.
            } else {
                $message.text(response.message || "Unable to save card.")
                        .css("color", "red");
            }
        },
        error: function () {
            $message.text("An error occurred while saving.")
                    .css("color", "red");
        },
        complete: function () {
            $button.prop("disabled", false).text("Save Card");
        }
