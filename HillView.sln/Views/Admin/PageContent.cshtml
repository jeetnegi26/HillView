$("#sectionItemsContainer").on("click", ".delete-section-item", function () {
    var $button = $(this);
    var $card = $button.closest(".section-item-card");
    var itemId = $card.find(".item-id").val();

    // Unsaved card: remove it directly without calling the API.
    if (!itemId ||
        itemId === "00000000-0000-0000-0000-000000000000") {

        $card.remove();

        if ($("#sectionItemsContainer .section-item-card").length === 0) {
            $("#noSectionItems").show();
        }

        return;
    }

    if (!confirm("Are you sure you want to delete this card?")) {
        return;
    }

    var token = $(
        "#sectionAntiForgeryToken input[name='__RequestVerificationToken']"
    ).val();

    $button.prop("disabled", true).text("Deleting...");

    $.ajax({
        url: '@Url.Action("DeleteSectionItemContent", "Admin")',
        type: "POST",
        data: {
            id: itemId,
            __RequestVerificationToken: token
        },
        success: function (response) {
            if (response.success) {
                $card.remove();

                if ($("#sectionItemsContainer .section-item-card").length === 0) {
                    $("#noSectionItems").show();
                }
            } else {
                alert(response.message || "Unable to delete the card.");
                $button.prop("disabled", false).text("Delete Card");
            }
        },
        error: function (xhr) {
            console.error(xhr.responseText);
            alert("An error occurred while deleting the card.");
            $button.prop("disabled", false).text("Delete Card");
        }
    });
});


$("#sectionItemsContainer").on("click", ".manage-card-images", function () {
    var $button = $(this);
    var $card = $button.closest(".section-item-card");
    var itemId = $card.find(".item-id").val();

    // The card must be saved before its images can be managed.
    if (!itemId ||
        itemId === "00000000-0000-0000-0000-000000000000") {
        alert("Please save this card before managing its images.");
        return;
