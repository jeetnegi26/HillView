$("#sectionItemsContainer").on("click", ".upload-card-image", function () {
    var $button = $(this);
    var $card = $button.closest(".section-item-card");
    var itemId = $card.find(".item-id").val();

    var $file = $card.find(".card-image-file");
    var $altText = $card.find(".card-image-alt");
    var $caption = $card.find(".card-image-caption");
    var $message = $card.find(".card-image-upload-message");

    if (!itemId ||
        itemId === "00000000-0000-0000-0000-000000000000") {
        alert("Please save the card before uploading an image.");
        return;
    }

    var file = $file[0].files[0];

    if (!file) {
        $message.text("Please select an image file.")
            .removeClass("text-success")
            .addClass("text-danger");
        return;
    }

    var formData = new FormData();

    formData.append("file", file);
    formData.append("sectionItemId", itemId);
    formData.append("altText", $altText.val());
    formData.append("caption", $caption.val());

    var token = $(
        "#sectionAntiForgeryToken input[name='__RequestVerificationToken']"
    ).val();

    formData.append("__RequestVerificationToken", token);

    $button.prop("disabled", true).text("Uploading...");
    $message.text("").removeClass("text-success text-danger");

    $.ajax({
        url: '@Url.Action("Upload_Content_Image", "Admin")',
        type: "POST",
        data: formData,
        processData: false,
        contentType: false,

        success: function (response) {
            if (response.Success) {
                $message.text(response.Message)
                    .addClass("text-success");

                $file.val("");
                $altText.val("");
                $caption.val("");

                // Refresh the images displayed for this card.
                $card.find(".manage-card-images").trigger("click");
                $card.find(".manage-card-images").trigger("click");
            } else {
                $message.text(
                    response.Message || "Image upload failed."
                ).addClass("text-danger");
            }
        },

        error: function (xhr) {
            console.error(xhr.responseText);

            $message.text("An error occurred while uploading the image.")
                .addClass("text-danger");
        },

