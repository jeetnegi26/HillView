$("#sectionImagesList").on("click", ".save-section-image-edit", function () {
    var $button = $(this);
    var $row = $button.closest(".section-image-row");
    var $message = $row.find(".section-image-edit-message");

    var imageId = $row.attr("data-image-id");
    var sectionId = $("#editSectionId").val();
    var altText = $row.find(".edit-section-image-alt").val();
    var caption = $row.find(".edit-section-image-caption").val();
    var displayOrderValue = $row.find(".edit-section-image-order").val();
    var status = $row.find(".edit-section-image-status").is(":checked");

    var displayOrder = Number(displayOrderValue);

    if (!imageId || !sectionId) {
        $message.text("Image or section ID is missing.")
            .removeClass("text-success")
            .addClass("text-danger");
        return;
    }

    if (displayOrderValue.trim() === "" ||
        !Number.isInteger(displayOrder) ||
        displayOrder < 0) {
        $message.text("Enter a valid display order (0 or greater).")
            .removeClass("text-success")
            .addClass("text-danger");
        return;
    }

    var token = $("#sectionAntiForgeryToken")
        .find("input[name='__RequestVerificationToken']")
        .val();

    $button.prop("disabled", true);
    $message.text("Saving...")
        .removeClass("text-danger text-success");

    $.ajax({
        url: '@Url.Action("UpdateSectionImage", "Admin")',
        type: "POST",
        data: {
            id: imageId,
            sectionId: sectionId,
            altText: altText,
            caption: caption,
            displayOrder: displayOrder,
            status: status,
            __RequestVerificationToken: token
        },
        success: function (response) {
            if (response && response.success) {
                $message.text(response.message || "Image updated successfully.")
                    .removeClass("text-danger")
                    .addClass("text-success");

                $("#loadSectionImages").trigger("click");
            } else {
                $message.text(
                    response && response.message
                        ? response.message
                        : "Unable to update image."
                ).removeClass("text-success")
                 .addClass("text-danger");
            }
        },
        error: function (xhr) {
            var message = "An error occurred while updating the image.";

            if (xhr.responseJSON && xhr.responseJSON.message) {
                message = xhr.responseJSON.message;
            }

            $message.text(message)
                .removeClass("text-success")
                .addClass("text-danger");
        },
        complete: function () {
            $button.prop("disabled", false);
        }
    });
});


