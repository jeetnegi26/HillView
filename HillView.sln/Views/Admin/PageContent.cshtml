$("#saveSectionButton").on("click", function () {
    var sectionId = $("#editSectionId").val();
    var buttonId = $("#sectionButtonId").val();
    var title = $("#sectionButtonTitle").val().trim();
    var url = $("#sectionButtonUrl").val().trim();
    var displayOrder = $("#sectionButtonDisplayOrder").val();

    if (!sectionId) {
        $("#sectionButtonSaveMessage")
            .text("Please select a section.")
            .addClass("text-danger");
        return;
    }

    if (!title) {
        $("#sectionButtonSaveMessage")
            .text("Button text is required.")
            .addClass("text-danger");
        $("#sectionButtonTitle").focus();
        return;
    }

    if (displayOrder === "" || Number(displayOrder) < 0) {
        $("#sectionButtonSaveMessage")
            .text("Display order must be zero or greater.")
            .addClass("text-danger");
        $("#sectionButtonDisplayOrder").focus();
        return;
    }

    var token = $("#sectionAntiForgeryToken")
        .find('input[name="__RequestVerificationToken"]')
        .val();

    $("#saveSectionButton").prop("disabled", true);
    $("#sectionButtonSaveMessage")
        .removeClass("text-danger text-success")
        .text("Saving...");

    $.ajax({
        url: '@Url.Action("SaveSectionButton", "Admin")',
        type: "POST",
        dataType: "json",
        data: {
            __RequestVerificationToken: token,
            sectionId: sectionId,
            id: buttonId || null,
            title: title,
            url: url,
            target: $("#sectionButtonTarget").val(),
            cssClass: $("#sectionButtonCssClass").val().trim(),
            buttonType: $("#sectionButtonType").val().trim(),
            displayOrder: Number(displayOrder),
            status: $("#sectionButtonStatus").is(":checked")
        },

        success: function (response) {
            if (!response.success) {
                $("#sectionButtonSaveMessage")
                    .removeClass("text-success")
                    .addClass("text-danger")
                    .text(response.message || "Unable to save the button.");
                return;
            }

            $("#sectionButtonSaveMessage")
                .removeClass("text-danger")
                .addClass("text-success")
                .text(response.message || "Button saved successfully.");

            // Reset the form for the next button.
            $("#sectionButtonId").val("");
            $("#sectionButtonTitle").val("");
            $("#sectionButtonUrl").val("");
            $("#sectionButtonTarget").val("_self");
            $("#sectionButtonCssClass").val("");
            $("#sectionButtonType").val("");
            $("#sectionButtonDisplayOrder").val("1");
            $("#sectionButtonStatus").prop("checked", true);
            $("#sectionButtonFormTitle").text("Add Section Button");

            // Refresh the list.
            $("#loadSectionButtons").trigger("click");
        },

        error: function (xhr) {
            var message = "An error occurred while saving the button.";

            if (xhr.responseJSON && xhr.responseJSON.message) {
                message = xhr.responseJSON.message;
            }

            $("#sectionButtonSaveMessage")
                .removeClass("text-success")
                .addClass("text-danger")
                .text(message);
        },

        complete: function () {
            $("#saveSectionButton").prop("disabled", false);
        }
    });
});

    $("#sectionItemsContainer").on("click", ".manage-card-buttons", function () {
        var $button = $(this);
        var $card = $button.closest(".section-item-card");
        var itemId = $card.find(".item-id").val();

        // A card must be saved before buttons can be managed.
        if (!itemId ||
            itemId === "00000000-0000-0000-0000-000000000000") {
            alert("Please save this card before managing its buttons.");
            return;
        }

        // Associate the button manager with the selected card.
        $("#cardButtonSectionItemId").val(itemId);
        $("#cardButtonId").val("");
        $("#cardButtonTitle").val("");
        $("#cardButtonUrl").val("");
        $("#cardButtonTarget").val("_self");
        $("#cardButtonCssClass").val("");
        $("#cardButtonType").val("");
        $("#cardButtonDisplayOrder").val("1");
        $("#cardButtonStatus").prop("checked", true);

        $("#cardButtonFormTitle").text("Add Card Button");
        $("#cardButtonSaveMessage")
            .removeClass("text-danger text-success")
            .text("");

        $("#cardButtonsError").hide();
        $("#cardButtonsLoading").hide();
        $("#noCardButtons").hide();

        // Display the card button manager.

        // Move the shared manager into the card that was clicked.
        $("#cardButtonManager").appendTo($card).show();


        // Load buttons belonging to this card.
        $("#loadCardButtons").trigger("click");

        $("html, body").animate({
            scrollTop: $("#cardButtonManager").offset().top - 30
        }, 300);
    });


