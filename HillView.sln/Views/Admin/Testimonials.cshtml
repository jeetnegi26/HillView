@model IEnumerable<DTOs.TestimonialVM>

@{
    ViewBag.Title = "Testimonials";
    Layout = "~/Views/Shared/Admin/_AdminLayoutPage.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Testimonials</h2>
            <p class="text-muted mb-0">
                Manage customer reviews and ratings.
            </p>
        </div>

        <a href="@Url.Action("TestimonialAction", "Admin")"
           class="btn btn-primary">
            <i class="ti ti-plus"></i> Add Testimonial
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead>
                        <tr>
                            <th title="Client Name">Name</th>
                            <th>Review</th>
                            <th>Rating</th>
                            <th title="Display Order">Order</th>
                            <th>Status</th>
                            <th style="width: 150px;">Created At</th>
                            <th class="text-end" style="width: 150px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.ClientName</strong>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.ReviewText)
                                            ? "-"
                                            : item.ReviewText)
                                    </td>

                                    <td>@item.Rating / 5</td>

                                    <td>@item.DisplayOrder</td>

                                    <td>
                                        @if (item.Status)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>

                                    <td>
                                        @(item.CreatedAt == DateTime.MinValue
                                            ? "-"
                                            : item.CreatedAt.ToLocalTime()
                                                .ToString("dd MMM yyyy"))
                                    </td>

                                    <td class="text-end">
                                        <a href="@Url.Action(
                                            "TestimonialAction",
                                            "Admin",
                                            new { id = item.Id })"
                                           class="btn btn-sm btn-primary">
                                            Edit
                                        </a>

                                        @using (Html.BeginForm(
                                            "DeleteTestimonial",
                                            "Admin",
                                            new { id = item.Id },
                                            FormMethod.Post,
                                            new { @class = "d-inline delete-testimonial-form" }))
                                        {
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">
                                                Delete
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-4">
                                    No testimonials found. Click
                                    <strong>Add Testimonial</strong>
                                    to create one.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $(".delete-testimonial-form").on("submit", function (e) {
                if (!confirm(
                    "Are you sure you want to delete this testimonial?"
                )) {
                    e.preventDefault();
                }
            });
        });
    </script>
}
