
@model DTOs.AdminSidebarVM

@{
    ViewBag.Title = "Menu Management";
    Layout = "~/Views/Shared/Admin/_AdminLayoutPage.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show"
                             role="alert">
                            @TempData["SuccessMessage"]

                            <button type="button" class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show"
                             role="alert">
                            @TempData["ErrorMessage"]

                            <button type="button" class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Close"></button>
                        </div>
                    }
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <h4 class="card-title mb-1">Menu Management</h4>
                            <p class="text-muted mb-0">
                                Manage the groups and items displayed in your admin sidebar.
                            </p>
                        </div>

                        <a href="@Url.Action("AddMenuItem", "Admin")"
                           class="btn btn-primary">
                            <i class="ti ti-plus"></i> Add Menu Item
                        </a>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Menu Structure</th>
                                    <th>Controller</th>
                                    <th>Action</th>
                                    <th>Order</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.StandaloneItems)
                                {
                                    @RenderMenuItem(item, 0)
                                }

                                @foreach (var group in Model.Groups)
                                {
                                    <tr class="table-light">
                                        <td colspan="5">
                                            <strong>
                                                <i class="ti ti-folder me-1"></i>
                                                @group.Title
                                            </strong>
                                            <small class="text-muted ms-2">
                                                Group
                                            </small>
                                        </td>

                                    </tr>

                                    foreach (var item in group.Items)
                                    {
                                        @RenderMenuItem(item, 0)
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <p class="text-muted small mb-0">
                        This page currently displays your menu structure.
                        Add, edit, and reorder functionality will be added next.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@helper RenderMenuItem(DTOs.AdminMenuItemVM item, int level)
{
    <tr>
        <td>
            <span style="padding-left: @(level * 24)px;">
                @if (!string.IsNullOrWhiteSpace(item.Icon))
                {
                    <i class="@item.Icon me-1"></i>
                }

                @item.Title
            </span>
        </td>
        <td>@item.Controller</td>
        <td>@item.Action</td>
        <td>@item.DisplayOrder</td>
        <td>
            @if (item.Status)
            {
                <span class="badge bg-success">Active</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactive</span>
            }
        </td>

        <td>
            <a href="@Url.Action("EditMenuItem", "Admin",
        new { id = item.Id })"
               class="btn btn-sm btn-primary">
                <i class="ti ti-edit"></i> Edit
            </a>

            @using (Html.BeginForm("DeleteMenuItem", "Admin",
                new { id = item.Id }, FormMethod.Post,
                new { style = "display:inline;" }))
            {
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-sm btn-danger"
                        onclick="return confirm('Are you sure you want to delete this menu item?');">
                    <i class="ti ti-trash"></i> Delete
                </button>
            }
        </td>


    </tr>

    foreach (var child in item.Children)
    {
        @RenderMenuItem(child, level + 1)
    }
}
