
@model DTOs.ButtonVM

@{
    ViewBag.Title = Model.Id == Guid.Empty
        ? "Add Button"
        : "Edit Button";

    Layout = "~/Views/Shared/Admin/_AdminLayoutPage.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>@ViewBag.Title</h2>
            <p class="text-muted mb-0">
                Configure a button for a section or section item.
            </p>
        </div>

        <a href="@Url.Action("Buttons", "Admin")"
           class="btn btn-dark-light">
            Back to Buttons
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            @using (Html.BeginForm(
                "ButtonAction",
                "Admin",
                FormMethod.Post,
                new { id = "buttonForm" }))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.CreatedAt)
                @Html.HiddenFor(m => m.UpdatedAt)


                if (!ViewData.ModelState.IsValid)
                {
                    <div id="formErrors">
                        @Html.ValidationSummary(false, "",
                            new { @class = "alert alert-danger" })
                    </div>
                }

                <div class="row">
                    @*<div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.SectionId,
                            new { @class = "form-label" })

                        @Html.DropDownListFor(
                            m => m.SectionId,
                            (SelectList)ViewBag.Sections,
                            "-- Select Section --",
                            new { @class = "form-select", id = "SectionId" })

                        @Html.ValidationMessageFor(
                            m => m.SectionId,
                            "",
                            new { @class = "text-danger" })
                    </div>*@
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="SectionId">Section</label>
                        @Html.DropDownListFor(
                            m => m.SectionId,
                            (SelectList)ViewBag.Sections,
                            "-- Select Section --",
                            new { @class = "form-select", id = "SectionId" })
                        @Html.ValidationMessageFor(
                            m => m.SectionId, "", new { @class = "text-danger" })
                    </div>

                    @*<div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.SectionItemId,
                            new { @class = "form-label" })

                        @Html.DropDownListFor(
                            m => m.SectionItemId,
                            (SelectList)ViewBag.SectionItems,
                            "-- Select Section Item --",
                            new { @class = "form-select", id = "SectionItemId" })

                        @Html.ValidationMessageFor(
                            m => m.SectionItemId,
                            "",
                            new { @class = "text-danger" })
                    </div>*@
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="SectionItemId">Section Item</label>
                        @Html.DropDownListFor(
                            m => m.SectionItemId,
                            (SelectList)ViewBag.SectionItems,
                            "-- Select Section Item --",
                            new { @class = "form-select", id = "SectionItemId" })
                        @Html.ValidationMessageFor(
                            m => m.SectionItemId, "", new { @class = "text-danger" })
                    </div>
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.Title,
                            new { @class = "form-label" })
                        <span class="text-danger">*required</span>
                        @Html.TextBoxFor(m => m.Title,
                            new
                            {
                                @class = "form-control",
                                placeholder = "Enter button title"
                            })

                        @Html.ValidationMessageFor(
                            m => m.Title,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.Url,
                            new { @class = "form-label" })
                        <span class="text-danger">*required</span>
                        @Html.TextBoxFor(m => m.Url,
                            new
                            {
                                @class = "form-control",
                                placeholder = "/contact or https://example.com"
                            })

                        @Html.ValidationMessageFor(
                            m => m.Url,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.Target,
                            new { @class = "form-label" })

                        @Html.DropDownListFor(
                            m => m.Target,
                            new SelectList(new[]
                            {
                                new { Value = "_self", Text = "Same tab (_self)" },
                                new { Value = "_blank", Text = "New tab (_blank)" }
                            }, "Value", "Text", Model.Target ?? "_self"),
                            new { @class = "form-select" })

                        @Html.ValidationMessageFor(
                            m => m.Target,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.ButtonType,
                            new { @class = "form-label" })

                        @Html.TextBoxFor(m => m.ButtonType,
                            new
                            {
                                @class = "form-control",
                                placeholder = "e.g. Primary, Secondary, CTA"
                            })

                        @Html.ValidationMessageFor(
                            m => m.ButtonType,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.CssClass,
                            new { @class = "form-label" })

                        @Html.TextBoxFor(m => m.CssClass,
                            new
                            {
                                @class = "form-control",
                                placeholder = "e.g. btn btn-primary"
                            })

                        @Html.ValidationMessageFor(
                            m => m.CssClass,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.DisplayOrder,
                            new { @class = "form-label" })

                        @Html.TextBoxFor(m => m.DisplayOrder,
                            new
                            {
                                @class = "form-control",
                                type = "number",
                                min = "0"
                            })

                        @Html.ValidationMessageFor(
                            m => m.DisplayOrder,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="col-12 mb-3">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.Status,
                                new { @class = "form-check-input" })

                            @Html.LabelFor(m => m.Status,
                                new { @class = "form-check-label" })
                        </div>
                    </div>
                </div>

                <hr />

                <button type="submit"
                        id="saveButton"
                        class="btn btn-indigo">
                   Save Button
                </button>

                <a href="@Url.Action("Buttons", "Admin")"
                   class="btn btn-outline-danger">
                    Cancel
                </a>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
                        // Only one parent can be selected.
$("#SectionId").on("change", function () {
    var sectionId = $(this).val();
    var $sectionItem = $("#SectionItemId");

    // Clear the old selection and items.
    $sectionItem.empty();
    $sectionItem.append(
        $("<option>", {
            value: "",
            text: "-- Select Section Item --"
        })
    );

    if (!sectionId) {
        return;
    }

    $.ajax({
        url: '@Url.Action("GetImageSectionItems", "Admin")',
        type: "GET",
        data: { sectionId: sectionId },
        success: function (response) {
            if (!response || !response.success) {
                alert("Unable to load section items.");
                return;
            }

            $.each(response.items, function (_, item) {
                $sectionItem.append(
                    $("<option>", {
                        value: item.id,
                        text: item.title
                    })
                );
            });
        },
        error: function () {
            alert("An error occurred while loading section items.");
        }
    });
});

            $("#SectionItemId").on("change", function () {
                if ($(this).val()) {
                    $("#SectionId").val("");
                }
            });

            $("#SectionItemId").on("change", function () {
                if ($(this).val()) {
                    $("#SectionId").val("");
                }
            });

            $("#buttonForm").on("submit", function (e) {
                var sectionId = $("#SectionId").val();
                var sectionItemId = $("#SectionItemId").val();

                if (!!sectionId === !!sectionItemId) {
                    e.preventDefault();
                    alert("Select either a Section or a Section Item, but not both.");
                    return;
                }

                if ($(this).valid()) {
                    $("#saveButton").prop("disabled", true);
                }
            });
        });
    </script>
}
