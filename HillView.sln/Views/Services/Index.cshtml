@if (data3 != null)
{
    var items = data3.Items.ToList();
    <section class="industries-section">
        <div class="industries-box">
            <div class="container industries-container">
                <div class="home-head">
                    <h3>@data3.Title</h3>
                    <h2>@data.Heading</h2>
                </div>

                <div class="industries-item-box">
                    <div class="industries-carousel owl-carousel owl-theme">
                        @foreach (var item in items)
                        {
                            <div class="item">
                                <div class="industries-item">
                                    <img src="~/Content/Uploads/@item.Images[0].ImageUrl" />
                                    <p>
                                        <span>@item.Title </span>@item.Description
                                    </p>
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    </section>
}



<section class="additional-section">
    <div class="additional-box">
        <div class="additional-container container">
            <div class="additional-items">
                <div class="additional-row row">

                    @if (data4 != null)
                    {
                        var items = data4.Items.ToList();
                        <!-- Staff Augmentation - Intro -->
                        <div class="additional-intro">
                            <div class="additional-card">
                                <h3 class="name">@data4.SubHeading</h3>
                                <h2>@data4.Heading</h2>
                                <p>
                                    @data4.Description
                                </p>
                            </div>
                        </div>
                        <!-- First Image -->
                        <div class="additional-image additional-image-one">
                            <img src="~/Content/Uploads/@data4.Images[0].ImageUrl" alt="@data4.Images[0].AltText" />
                        </div>
                        <!-- Staff Augmentation - Advantage -->
                        <div class="additional-advantage additional-advantage-one">
                            <div class="additional-card">
                                <h3>@items[0].Title</h3>
                                <ul>
                                    @foreach (var childItem in items[0].Children)
                                    {
                                        <li><i class="bi bi-check-circle-fill"></i><p>@childItem.Title</p></li>
                                    }
                                </ul>
                                <div class="additional-best">
                                    <p>
                                        <strong>@items[1].SubHeading</strong> @items[1].Description
                                    </p>
                                </div>
                            </div>
                        </div>
                    }

                    @if (data5 != null)
                    {
                        var consultantItems = data4.Items.ToList();
                        <!-- Consulting - Intro -->
                        <div class="additional-consulting">
                            <div class="additional-card">
                                <h3 class="name">@data5.SubHeading</h3>
                                <h2>@data5.Heading</h2>
                                <p>
                                    @data5.Description
                                </p>

                                <div class="additional-best">
                                    <p>
                                        <strong>@consultantItems[1].SubHeading<</strong>  @consultantItems[1].Description
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Second Image -->
                        <div class="additional-image additional-image-two">
                            <img src="~/Content/Uploads/@data5.Images[0].ImageUrl" alt="@data4.Images[0].AltText" />
                        </div>

                        <!-- Consulting - Advantage -->
                        <div class="additional-advantage additional-advantage-two">
                            <div class="additional-card">
                                <h3>@consultantItems[0].Title</h3>

                                <ul>
                                    @foreach (var childItem in consultantItems[0].Children)
                                    {
                                        <li><i class="bi bi-check-circle-fill"></i><p>@childItem.Title</p></li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>
</section>


@if (data6 != null)
{
    var items = data6.Items.ToList();
    <section class="areas-section">
        <div class="areas-box">
            <div class="areas-container container">
                <div class="home-head">
                    <h3>@data6.Title </h3>
                    <h2>@data6.Heading </h2>
                </div>
            </div>
            <div class="areas-items-box">
                <div class="areas-items-container container">
                    <div class="areas-items">
                        <div class="areas-row row">
                            @foreach (var item in items)
                            {
                                <div class="col-lg-4 col-md-6 col-12 areas-col">
                                    <div class="areas-item">
                                        <div class="areas-item-icon">
                                            <img src="~/Content/Uploads/@item.Images[0].ImageUrl" alt="@item.Images[0].AltText"/>
                                        </div>
                                        <h3>@item.Title</h3>
                                        <p>
                                            @item.Description
                                        </p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

}



<script src="~/Scripts/owl.carousel.min.js"></script>
<script>
    $('.industries-carousel').owlCarousel({
        loop: true,
        margin: 20,
        nav: false,
        dots: true,
        autoplay: true,
        autoplayTimeout: 7000,
        autoplayHoverPause: true,
        slideBy: 3,

        responsive: {
            0: {
                items: 1,
                slideBy: 1
            },
            600: {
                items: 2,
                slideBy: 2
            },
            1000: {
                items: 3,
                slideBy: 3
            }
        }
    });
</script>