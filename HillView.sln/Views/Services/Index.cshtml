
@{
    ViewBag.Title = "Services";
}

<link href="~/Content/css/otherbanner.css" rel="stylesheet" />
<link href="~/Content/css/owl.carousel.min.css" rel="stylesheet" />

<style>
    .banner-text-box {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    .banner-text {
        max-width: 900px;
        text-align: center;
        position: absolute;
    }

        .banner-text small {
            color: var(--primary)
        }

    .services-box {
        padding: 05rem 0 3rem;
        /*position: relative;
        overflow: hidden;*/
    }

    /* Faded circular glow */
    /*.services-box::before {
            content: "";
            position: absolute;
            width: 700px;
            height: 700px;
            left: 50%;
            top: 45%;
            transform: translate(-50%, -50%);
            background: radial-gradient( circle, rgba(0, 150, 150, 0.45) 0%, rgba(0, 120, 120, 0.25) 25%, rgba(0, 100, 100, 0.10) 45%, rgba(0, 100, 100, 0) 72% );
            pointer-events: none;
            z-index: 0;
        }*/

    .services-items {
        padding: 0 3rem;
    }

    .ser-icon img {
        width: 4rem;
        padding-right: 1rem;
    }

    .service-item {
        padding-bottom: 2rem;
    }

    .ser-img-box {
        padding-left: 5rem;
    }

    .ser-desc p {
        font-size: 14px
    }

    .ser-desc h3 {
        font-weight: 600;
    }

    .industries-item-box {
        padding-bottom: 5rem;
    }

    .industries-item {
    }

        .industries-item img {
            border-radius: 25px;
        }

        .industries-item p {
            padding: 10px;
        }

        .industries-item span {
            font-weight: 600;
        }

.additional-section {
    width: 100%;
    padding: 2rem 0 5rem;;
}


.additional-section .additional-row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 14px 14px;
    margin: 0;
}

.additional-section .additional-row > div {
    min-width: 0;
    padding: 0;
}

    .additional-card {
        background: var(--gradient1);
    }

    .additional-section .additional-card {
        height: 100%;
        padding: 30px;
        border: 1px solid #075bdb;
        border-radius: 13px;
        box-sizing: border-box;
    }

.additional-section h3 {
    font-weight: 500;
    margin: 0 0 10px;
}

.additional-section h2 {
    line-height: 1.2;
    font-weight: 600;
    margin: 0 0 10px;
}

.additional-section p {
    line-height: 1.4;
    font-size: 14px;
    margin: 0;
}

.additional-section .additional-intro {
    grid-column: 1 / 8;
    grid-row: 1;
}

.additional-section .additional-image-one {
    grid-column: 1 / 5;
    grid-row: 2;
}

.additional-section .additional-advantage-one {
    grid-column: 8 / 13;
    grid-row: 1 / 3;
    padding-left: 0;
}

.additional-section .additional-consulting {
    grid-column: 1 / 7;
    grid-row: 3;
    margin-left: 4px;
}

.additional-section .additional-image-two {
    grid-column: 5 / 8;
    grid-row: 2;
}

.additional-section .additional-advantage-two {
    grid-column: 7 / 13;
    grid-row: 3;
    margin-left: 0;
}

.additional-section .additional-image {
    min-height: 189px;
    overflow: hidden;
    border-radius: 12px;
}

.additional-section .additional-image img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 189px;
    object-fit: cover;
    border-radius: inherit;
}

.additional-section .additional-intro .additional-card {
    min-height: 207px;
}

.additional-section .additional-advantage-one .additional-card {
    min-height: 407px;
}

.additional-section .additional-consulting .additional-card,
.additional-section .additional-advantage-two .additional-card {
    min-height: 284px;
}

.additional-section .additional-advantage ul {
    list-style: none;
    padding: 0;
    margin: 22px 0 0;
}

.additional-section .additional-advantage li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 10px;
}

.additional-section .additional-advantage li span {
    flex: 0 0 12px;
    width: 12px;
    height: 12px;
    line-height: 12px;
    text-align: center;
    border-radius: 50%;
    font-weight: 700;
    margin-top: 2px;
}

.additional-section .additional-advantage li p {
    flex: 1;
}

.additional-section .additional-best {
    margin-top: 22px;
    padding-top: 13px;
    border-top: 1px solid var(--primary);
}

.additional-section .additional-advantage-two ul {
    margin-top: 22px;
}

/* Tablet */
@@media (max-width: 991px) {
    .additional-section .additional-row {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
    }

    .additional-section .additional-intro {
        grid-column: 1 / 2;
        grid-row: 1;
    }

    .additional-section .additional-image-one {
        grid-column: 1 / 2;
        grid-row: 2;
    }

    .additional-section .additional-advantage-one {
        grid-column: 2 / 3;
        grid-row: 1 / 3;
    }

    .additional-section .additional-consulting {
        grid-column: 1 / 2;
        grid-row: 3;
        margin-left: 0;
    }

    .additional-section .additional-image-two {
        grid-column: 1 / 2;
        grid-row: 4;
    }

    .additional-section .additional-advantage-two {
        grid-column: 2 / 3;
        grid-row: 3 / 5;
    }

    .additional-section .additional-card {
        padding: 22px;
    }
}

/* Mobile: stack in the exact reference order */
@@media (max-width: 800px) {
    .additional-section {
        padding: 10px 0;
    }

    .additional-section .additional-row {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .additional-section .additional-intro {
        order: 1;
    }

    .additional-section .additional-image-one {
        order: 2;
    }

    .additional-section .additional-advantage-one {
        order: 3;
    }

    .additional-section .additional-consulting {
        order: 4;
    }

    .additional-section .additional-image-two {
        order: 5;
    }

    .additional-section .additional-advantage-two {
        order: 6;
    }

    .additional-section .additional-card {
        min-height: 0 !important;
        padding: 18px;
        border-radius: 9px;
    }

    .additional-section .additional-intro .additional-card {
        min-height: 0;
    }

    .additional-section h3 {
        margin-bottom: 8px;
    }

        .additional-section h2 {
            line-height: 1.2;
            margin-bottom: 8px;
            font-size: 24px;
        }

    .additional-section p {
        font-size: 11px;
        line-height: 1.4;
    }

    .additional-section .additional-image {
        width: 100%;
        height: auto;
        min-height: 0;
        aspect-ratio: 1.55 / 1;
        border-radius: 9px;
    }

    .additional-section .additional-image img {
        width: 100%;
        height: 100%;
        min-height: 0;
        object-fit: cover;
    }

    .additional-section .additional-advantage ul {
        margin-top: 15px;
    }

    .additional-section .additional-advantage li {
        gap: 8px;
        margin-bottom: 8px;
    }

    .additional-section .additional-advantage li span {
        flex-basis: 10px;
        width: 10px;
        height: 10px;
        line-height: 10px;
        font-size: 8px;
    }

    .additional-section .additional-best {
        margin-top: 17px;
        padding-top: 12px;
    }
}

    .additional-card .name{
        color: var(--primary)
    }

    .bi-check-circle-fill {
        color: #A4FFA2;
    }
    .areas-items-box {
        background: var(--lightbg);
        padding-bottom: 5rem;
    }
    .areas-items{
        padding:3rem 0
    }
    .areas-item{
        padding: 1rem 0.5rem;
    }
    .areas-item-icon img {
        width: 10%;
        padding-bottom: 10px;
    }
    .areas-item h3 {
        font-size: 18px;
        font-weight: 500
    }
    .areas-item p {
        font-size: 14px;
    }


    @@media screen and (min-width: 600px) and (max-width: 1023px) {
        .banner-text {
            max-width: 600px;
        }
    }

    @@media (max-width: 600px) {
        .banner-text {
            max-width: 400px;
            text-align: left;
        }

        .home-head {
            padding: 0rem 1rem 5rem;
        }

        .services-items {
            padding: 0 0rem;
        }

        .industries-item-box {
            padding: 0 1.5rem 5rem;
        }

        .additional-items {
            padding: 0 1rem;
        }
    }

    @@media (max-width: 430px) {
        .banner-text {
            max-width: 350px;
        }
    }

    @@media (max-width: 380px) {
        .banner-text {
            max-width: 340px;
        }
    }
</style>

