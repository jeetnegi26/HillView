
@model DTOs.LayoutDataVM

<div style="z-index: 10;" class="navbar">
    <div class="container nav-boxx">
        <div class="row">
            <div class="col-lg-12 col-md-4 col-4 navbar-menu nav justify-content-between">

                <div class="navbar-logo">
                    <a href="/Home/Index">
                        @if (Model != null && !string.IsNullOrWhiteSpace(Model.Logo))
                        {
                            <img src="@Url.Content("~/content/logo/" + Model.Logo)"
                                 alt="@(Model.BrandName ?? "Hill View")" />
                        }
                        else
                        {
                            <span>@(Model != null ? Model.BrandName : "Hill View")</span>
                        }
                    </a>
                </div>


                <nav class="nav-items">
                    <ul class="mbl-ul">
                        @if (Model != null && Model.Navigation != null)
                        {
                            foreach (var item in Model.Navigation)
                            {
                                <li class="eng">
                                    <a class="nav-link" href="@Url.Content("~/" + item.Slug)">
                                        @item.Title
                                    </a>
                                </li>
                            }
                        }

                    </ul>
                </nav>

                <div class="quote-btn d-lg-flex d-md-none d-none align-items-center">
                    <div class="dropdown lang-dropdown-box ms-auto px-2">
                        <button class="btn btn-secondary dropdown-toggle lang-dropdown" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                            En
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                            <li><a class="dropdown-item" href="#" data-value="En" onclick="setLanguage(this)">English</a></li>
                            <li><a class="dropdown-item" href="#" data-value="Ar" onclick="setLanguage(this)">Arabic</a></li>
                        </ul>
                    </div>

                    <div class="btn-group">
                        <button type="button" class="btn btn-secondary dropdown-toggle quote-a" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="eng">Get A Quote</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/Logistics"><span class="eng">Logistics</span></a></li>
                            <li><a class="dropdown-item" href="/Warehouse"><span class="eng">Warehouse</span></a></li>
                            <li><a class="dropdown-item" href="/Home/ServiceForm"><span class="eng">Connect</span></a></li>
                        </ul>
                    </div>
                </div>

                <div class="d-lg-none d-md-flex d-flex">
                    <div class="d-lg-none d-md-flex d-flex px-2 pt-1 mobile-nav-right">
                        <div class="dropdown ms-auto px-1">
                            <button class="btn btn-secondary dropdown-toggle lang-dropdown" type="button" id="dropdownMenuButtonMbl" data-bs-toggle="dropdown" aria-expanded="false">
                                En
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButtonMbl">
                                <li><a class="dropdown-item" href="#" data-value="En" onclick="setLanguage(this)">English</a></li>
                                <li><a class="dropdown-item" href="#" data-value="Ar" onclick="setLanguage(this)">Arabic</a></li>
                            </ul>
                        </div>
                    </div>

                    <div class="navbar-icon">
                        <span></span>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
