
@model DTOs.LayoutDataVM

<div style="z-index: 10;" class="navbar">
    <div class="container nav-boxx">
        <div class="row">
            <div class="col-lg-12 col-md-4 col-4 navbar-menu nav justify-content-between">

                <div class="navbar-logo">
                    <a href="/Home/Index">
                        @if (Model != null && !string.IsNullOrWhiteSpace(Model.Logo))
                        {
                            <img src="@Url.Content("~/content/logo/" + Model.Logo)"
                                 alt="@(Model.BrandName ?? "Hill View")" />
                        }
                        else
                        {
                            <span>@(Model != null ? Model.BrandName : "Hill View")</span>
                        }
                    </a>
                </div>


                <nav class="nav-items">
                    <ul class="mbl-ul">
                        @if (Model != null && Model.Navigation != null)
                        {
                            foreach (var item in Model.Navigation)
                            {
                                <li class="eng">
                                    <a class="nav-link" href="@Url.Content("~/" + item.Slug)">
                                        @item.Title
                                    </a>
                                </li>
                            }
                        }

                    </ul>
                </nav>

                <div class="quote-btn d-lg-flex d-md-none d-none align-items-center">
                    <div class="why-us-nav">
                        <a class="btn btn-secondary">Why Us?</a>
                    </div>
                    <div class="contact-nav">
                        <a class="btn btn-primary mx-1">Contact Us</a>
                    </div>
                </div>

                <div class="d-lg-none d-md-flex d-flex ">
                    <div class="navbar-icon">
                        <span></span>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
