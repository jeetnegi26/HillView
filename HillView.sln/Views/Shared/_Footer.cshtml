@model DTOs.LayoutDataVM

<footer>
    <div class="container">

        <div class="footer-row d-flex flex-lg-row flex-lmd-row flex-column justify-content-between">
            <div class="footer-col footer-logo d-flex align-items-center">
                <a href="/">
                    @if (Model != null && !string.IsNullOrWhiteSpace(Model.Logo))
                    {
                        <img src="@Url.Content("~/Content/logo/" + Model.Logo)"
                             alt="@(Model.BrandName ?? "Hill View")" />
                    }
                    else if (Model != null && !string.IsNullOrWhiteSpace(Model.BrandName))
                    {
                        <span>@Model.BrandName</span>
                    }
                </a>
            </div>

            <div class="footer-col footer-links d-flex align-items-center">

                <div class="footer-links-items">
                    <ul class="eng d-lg-flex d-md-flex d-block justify-content-center m-0">
                        @if (Model.Navigation != null)
                        {
                            foreach (var item in Model.Navigation)
                            {
                                <li>
                                    <a class="px-2" href="@Url.Content("~/" + item.Slug)">
                                        @item.Title
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                </div>

            </div>

            <div class="footer-col footer-contact d-flex align-items-center">


                @if (Model.FooterLinks != null)
                {
                    if (Model.FooterLinks.Count > 0)
                    {
                        <div class="footer-contact-btn-box">
                            <a class="btn btn-primary" href="@Model.FooterLinks[0].Url">@Model.FooterLinks[0].Name</a>
                        </div>
                    }
                }
            </div>

        </div>

        <div class="copyright">
            <p class="eng m-0">
                @(string.IsNullOrWhiteSpace(Model.Copyright) ? "" : "© " + Model.Copyright)
            </p>
        </div>

        @if (Model.SocialLinks != null)
        {
                <div class="social-icons text-center ">
                    @foreach (var item in Model.SocialLinks)
                    {
                        <a class="px-2"><i class="@item.Icon"></i></a>
                    }
                    @*<a class="px-2"><i class="bi bi-twitter-x"></i></a>
                    <a class="px-2"><i class="bi bi-linkedin"></i></a>
                    <a class="px-2"><i class="bi bi-instagram"></i></a>*@
                </div>
            }



            </div>
</footer>