@model DTOs.AdminSidebarVM

@using System
@using System.Linq
<!-- Sidebar Start -->

<aside class="left-sidebar">
    <!-- Sidebar scroll-->
    <div>
        <div class="brand-logo text-lg-center text-start
            align-items-center justify-content-between">
            <a href="/admin/dashboard" class="text-nowrap logo-img">
                <img id="adminWebLogo"
                     src="/Content/profile/default-logo.png"
                     alt="Website Logo"
                     class="img-fluid w-50" />
            </a>

            <div class="close-btn d-xl-none d-block sidebartoggler cursor-pointer"
                 id="sidebarCollapse" style="position: absolute; top: 3%; right: 4%; ">
                <i class="ti ti-x fs-8"></i>
            </div>
        </div>
        <!-- Sidebar navigation-->
        <nav class="sidebar-nav scroll-sidebar data-simplebar">
            <ul class="list-unstyled components">
                @* Standalone menu items *@
                @foreach (var item in Model.StandaloneItems)
                {
                    @RenderMenuItem(item)
                }

                @* Grouped menu items *@
                @foreach (var group in Model.Groups)
                {
                    var groupId = "menu-" + group.Id.ToString("N");
                    var groupIsActive = HasActiveGroup(group);

                    <li class="sidebar-item">
                        <a class="sidebar-link has-arrow @(groupIsActive ? "" : "collapsed")"
                           href="javascript:void(0)"
                           data-bs-toggle="collapse"
                           data-bs-target="#@groupId"
                           aria-controls="@groupId"
                           aria-expanded="@(groupIsActive ? "true" : "false")">

                            <i class="ti ti-folder"></i>
                            <span class="hide-menu">@group.Title</span>
                        </a>

                        <ul id="@groupId"
                            class="collapse first-level @(groupIsActive ? "show" : "")">

                            @foreach (var item in group.Items)
                            {
                                @RenderMenuItem(item)
                            }

                        </ul>
                    </li>
                }
            </ul>
        </nav>
        <!-- End Sidebar navigation -->
    </div>
    <!-- End Sidebar scroll-->
</aside>
@functions {
    public string GetMenuUrl(DTOs.AdminMenuItemVM item)
    {
        if (!string.IsNullOrWhiteSpace(item.Url))
        {
            return Url.Content(item.Url);
        }

        if (!string.IsNullOrWhiteSpace(item.Controller) &&
            !string.IsNullOrWhiteSpace(item.Action))
        {
            return Url.Action(item.Action, item.Controller);
        }

        return "#";
    }




    private bool IsCurrentMenuItem(DTOs.AdminMenuItemVM item)
    {
        string menuUrl = GetMenuUrl(item);

        if (string.IsNullOrWhiteSpace(menuUrl) || menuUrl == "#")
            return false;

        Uri resolvedMenuUri;
        if (!Uri.TryCreate(
                Request.Url,
                menuUrl,
                out resolvedMenuUri))
        {
            return false;
        }

        string menuPath = resolvedMenuUri.AbsolutePath.TrimEnd('/');
        string currentPath = Request.Url.AbsolutePath.TrimEnd('/');

        return string.Equals(
            menuPath,
            currentPath,
            StringComparison.OrdinalIgnoreCase);
    }



    private bool HasActiveMenuItem(DTOs.AdminMenuItemVM item)
    {
        if (IsCurrentMenuItem(item))
            return true;

        return item.Children != null &&
               item.Children.Any(HasActiveMenuItem);
    }

    private bool HasActiveGroup(DTOs.AdminMenuGroupVM group)
    {
        return group.Items != null &&
               group.Items.Any(HasActiveMenuItem);
    }
}

@helper RenderMenuItem(DTOs.AdminMenuItemVM item)
{
    var hasChildren = item.Children != null && item.Children.Count > 0;
    var menuId = "item-" + item.Id.ToString("N");
    var isActive = IsCurrentMenuItem(item);
    var hasActiveChild = hasChildren && HasActiveMenuItem(item);

    <li class="sidebar-item @(isActive ? "selected" : "")">
        @if (hasChildren)
        {
            <a class="sidebar-link has-arrow @(hasActiveChild ? "" : "collapsed")"
               href="javascript:void(0)"
               data-bs-toggle="collapse"
               data-bs-target="#@menuId"
               aria-controls="@menuId"
               aria-expanded="@(hasActiveChild ? "true" : "false")">

                @if (!string.IsNullOrWhiteSpace(item.Icon))
                {
                    <i class="@item.Icon"></i>
                }

                <span class="hide-menu">@item.Title</span>
            </a>

            <ul id="@menuId"
                class="collapse second-level @(hasActiveChild ? "show" : "")">

                @foreach (var child in item.Children)
                {
                    @RenderMenuItem(child)
                }
            </ul>
        }
        else
        {
            <a class="sidebar-link @(isActive ? "active" : "")"
               href="@GetMenuUrl(item)">

                @if (!string.IsNullOrWhiteSpace(item.Icon))
                {
                    <i class="@item.Icon"></i>
                }

                <span class="hide-menu">@item.Title</span>
            </a>
        }
    </li>
}
<!--  Sidebar End -->
<script>
    $(function () {
        $.ajax({
            url: '@Url.Action("GetSidebarLogo", "Admin")',
            type: 'GET',
            cache: true,
            success: function (response) {
                if (response && response.success && response.logo) {
                    $('#adminWebLogo').attr('src', "/content/logo/" + response.logo);
                }
            },
            error: function () {
                // Keep the default logo if loading fails.
            }
        });
    });
</script>