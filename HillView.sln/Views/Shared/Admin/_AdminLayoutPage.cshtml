    <style>

        /* Keep the profile dropdown within the viewport */
        .app-header .navbar-nav .dropdown-menu-end {
            right: 0 !important;
            left: auto !important;
            min-width: 200px;
            max-width: calc(100vw - 20px);
            box-sizing: border-box;
        }

        /* Prevent the username and menu items from overflowing */
        .app-header .dropdown-menu .dropdown-item {
            white-space: normal;
            overflow-wrap: anywhere;
        }

        /* Keep the profile dropdown above page content */
        .app-header .dropdown-menu {
            z-index: 1050;
        }
    </style>
