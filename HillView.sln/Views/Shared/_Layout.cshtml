    <style>
        #dropdownMenuButton {
            text-transform: uppercase;
        }
        /* Loader*/
        .animation_text h2 {
            text-align: center;
            font-weight: 800;
            font-size: 51px;
            margin: 0;
            line-height: 60px;
        }

            .animation_text h2 span {
                display: block;
                margin-bottom: 40px;
            }

            .animation_text h2 p {
                margin: 0;
                transform: scale(0.8);
                animation-iteration-count: 1;
                -webkit-animation-name: scale;
                -webkit-animation-duration: 5s;
            }

            .animation_text h2 span img {
                width: 250px;
            }

        .animation_text {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            opacity: 0;
            animation-iteration-count: 1;
            -webkit-animation-name: fade;
            -webkit-animation-duration: 5s;
        }

        .shatter_wrap {
            position: relative;
            width: 100%;
            height: 100vh;
        }

        .running-image {
            position: absolute;
            top: 50%;
            left: -150px; /* Start off-screen */
            height: auto;
            transform: translateY(-50%);
            animation: runAnimation 2s linear forwards; /* Runs once */
        }

        @@keyframes runAnimation {
            0% {
                left: -100px; /* Start position */
            }

            100% {
                left: 100%; /* End position */
            }
        }

        @@-webkit-keyframes run {
            0% {
                left: -70%;
            }

            100% {
                left: 100%;
            }
        }

        @@-webkit-keyframes fade {
            0% {
                opacity: 0%;
            }

            30% {
                opacity: 0;
            }

            35% {
                opacity: 0.9;
            }

            100% {
                opacity: 1;
            }
        }

        @@-webkit-keyframes scale {
            0% {
                transform: scale(0.8);
            }

            30% {
                transform: scale(0.8);
            }

            35% {
                transform: scale(1);
            }

            100% {
                transform: scale(1);
            }
        }
        /*        .transform {
             transform: translateY(-100%);
        }*/
        .shatter_wrap {
            position: fixed;
            left: 0;
            right: 0;
            margin: 0 auto;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: #eee;
            transition: 1s ease;
        }

        @@media(max-width:550px) {
            .animation_text h2 p {
                font-size: 2rem;
            }
        }
    </style>
