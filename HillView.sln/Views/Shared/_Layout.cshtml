﻿@{
    string webname = "gsclogistics.com.sa";
    string webImg = webname + (ViewBag.Image == "" ? "/content/images/logo.png" : ViewBag.Image);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title</title>
    <meta name="keywords" content="Auto parts Dubai,Car spare parts Dubai,Dubai auto parts store,Dubai auto parts store,Car accessories Dubai,
          Genuine car parts Dubai,Online auto parts UAE,OEM auto parts Dubai,Aftermarket car parts Dubai,Cheap car parts Dubai,Best auto parts
          Dubai,Brake pads Dubai,Brake pads Dubai,Auto parts delivery Dubai,Auto parts delivery Dubai,Auto parts delivery Dubai,Luxury car parts Dubai,
          4x4 auto parts Dubai,Car batteries DubaiTyres and rims Dubai" />
    <meta name="description" content="@ViewBag.Description" />
    <meta property="og:title" content="@ViewBag.Title" />
    <meta property="og:url" content="@webname" />
    <meta property="og:image" content="@webImg" />

    <link href="~/Content/css/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/css/all.css" rel="stylesheet" />
    <link href="~/Content/css/fonts.css" rel="stylesheet" />
    <link href="~/Content/css/style.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.1/font/bootstrap-icons.min.css" rel="stylesheet" />

    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <style>
        #dropdownMenuButton {
            text-transform: uppercase;
        }
        /* Loader*/
        .animation_text h2 {
            text-align: center;
            font-weight: 800;
            font-size: 51px;
            margin: 0;
            line-height: 60px;
        }

            .animation_text h2 span {
                display: block;
                margin-bottom: 40px;
            }

            .animation_text h2 p {
                margin: 0;
                transform: scale(0.8);
                animation-iteration-count: 1;
                -webkit-animation-name: scale;
                -webkit-animation-duration: 5s;
            }

            .animation_text h2 span img {
                width: 250px;
            }

        .animation_text {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: wrap;
            opacity: 0;
            animation-iteration-count: 1;
            -webkit-animation-name: fade;
            -webkit-animation-duration: 5s;
        }

        .shatter_wrap {
            position: relative;
            width: 100%;
            height: 100vh;
        }

        .running-image {
            position: absolute;
            top: 50%;
            left: -150px; /* Start off-screen */
            height: auto;
            transform: translateY(-50%);
            animation: runAnimation 2s linear forwards; /* Runs once */
        }

        @@keyframes runAnimation {
            0% {
                left: -100px; /* Start position */
            }

            100% {
                left: 100%; /* End position */
            }
        }

        @@-webkit-keyframes run {
            0% {
                left: -70%;
            }

            100% {
                left: 100%;
            }
        }

        @@-webkit-keyframes fade {
            0% {
                opacity: 0%;
            }

            30% {
                opacity: 0;
            }

            35% {
                opacity: 0.9;
            }

            100% {
                opacity: 1;
            }
        }

        @@-webkit-keyframes scale {
            0% {
                transform: scale(0.8);
            }

            30% {
                transform: scale(0.8);
            }

            35% {
                transform: scale(1);
            }

            100% {
                transform: scale(1);
            }
        }
        /*        .transform {
             transform: translateY(-100%);
        }*/
        .shatter_wrap {
            position: fixed;
            left: 0;
            right: 0;
            margin: 0 auto;
            width: 100%;
            height: 100%;
            z-index: 9999;
            background: var(--bg);
            transition: 1s ease;
        }

        @@media(max-width:550px) {
            .animation_text h2 p {
                font-size: 2rem;
            }
        }
    </style>
    <style>
        .navbar a {
            color: var(--textnav);
            font-size: 16px;
        }

        .nav-active {
            color: var(--primary) !important;
            font-weight: 500;
        }

        .social-links {
            border-bottom: 1px solid var(--primary);
            color: var(--bg);
            background: var(--primary);
        }

        .social-icons {
        }

            .social-icons a {
                padding: 0 5px;
                font-size: 1.1rem;
            }

        .social-icon {
            font-size: 1.3rem !important;
        }

        .quote-a {
            padding: 0.375rem 15px;
            background-color: var(--primary);
            color: var(--bg) !important;
            border-radius: 10px;
        }

        .social-icons .dropdown-menu {
            width: 100%; /* Match the width of the dropdown button */
            min-width: unset; /* Prevent default minimum width */
            background-color: var(--primary)
        }

        .arb-nav a {
            font-size: 1.5rem;
        }
    </style>
</head>
<body>
    <div class="shatter_wrap transform">
        <div class="animation_text">
            <h2>
                <span><img src="~/Content/logo/logo.svg" alt="Logo" /></span>
            </h2>
        </div>
    </div>
    @{ Html.RenderAction("SharedData", "Layout"); }

    <div class="body">
        @RenderBody()
    </div>
    @{ Html.RenderAction("Footer", "Layout"); }
    <div class="sticky-button">
        <a class="layoutWhatsapp fixed-button" href="">
            <img class="whatsapp-svg" src="~/Content/Images/whatsapp.svg" />
        </a>
    </div>
    <script>
        $("document").ready(function () {
            var preloader = document.querySelector(".transform");
            if (preloader) {
                setTimeout(function () {
                    preloader.style.transform = "translateY(-100%)";
                    setTimeout(function () { preloader.style.display = "none"; }, 1000);
                }, 3000);
            }

            $(".navbar-icon").click(function () {
                $(this).toggleClass("active");
                $(".nav-items").toggleClass("active");
            });
        });

    </script>
</body>
</html>