@model DTOs.UIPageVM
@using System.Linq
@using DTOs
@{
    ViewBag.Title = string.IsNullOrWhiteSpace(Model.MetaTitle) ? Model.Title : Model.MetaTitle;

    var data = Model?.Sections?.FirstOrDefault(x => x != null && x.DisplayOrder == 1);

    var images = data?.Images?
        .Where(x => x != null)
        .ToList();

    var buttons = data?.Buttons?
        .Where(x => x != null)
        .ToList();

    var data2 = Model?.Sections?.FirstOrDefault(x => x != null && x.DisplayOrder == 2);
    var data3 = Model?.Sections?.FirstOrDefault(x => x != null && x.DisplayOrder == 3);

}

<link href="~/Content/css/otherbanner.css" rel="stylesheet" />


<style>
    .banner-text-box {
        flex-direction: column;
    }

    .banner-text-box {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    .banner-text {
        padding-top: 10rem;
        text-align: center;
        position: initial;
    }

        .banner-text small {
            color: var(--primary)
        }

    .job-usp-box {
        padding-top: 3rem;
    }

    .jobs-usp-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 24px;
    }

    .jobs-usp-col {
        width: 100%;
        max-width: 100%;
    }

    .jobs-usp-item {
        height: 100%;
        box-sizing: border-box;
        border: 1px solid var(--primary);
        padding: 2rem;
        border-radius: 25px;
    }

        .jobs-usp-item p {
            margin: 0;
        }

    @@media (max-width: 767px) {
        .jobs-usp-row {
            grid-template-columns: 1fr;
        }
    }

    .jobs-usp-item h3 {
        font-weight: 600;
        padding-bottom: 1rem;
    }

    .journey-section {
        padding: 3rem 0 5rem;
    }

    .journey-items-box {
        padding-top: 2.5rem;
    }

    .journey-item {
        display: flex;
        padding: 1rem 1.5rem 1rem 0;
    }

    .journey-item-icon {
        padding-right: 1rem;
    }

        .journey-item-icon .bi-check-circle {
            color: var(--primary);
        }

    .journney-img {
        padding: 3rem 0;
    }

    .journey-item-desc h3 {
        font-weight: 600;
    }

    .journey-head {
        font-weight: 500;
    }

    .journey-item-desc p {
        margin: 0
    }

    .jobs-items-box {
        padding-bottom: 5rem;
    }

    .job-item {
        padding: 1.3rem 2rem;
        margin-bottom: 1.5rem;
        border: 1px solid var(--secondary);
        border-radius: 25px;
        background: var(--gradient1);
    }

    .time {
        color: var(--text);
        font-size: 12px;
        opacity: 0.8;
    }

    .designation {
        padding-top: 1rem;
        margin-bottom: 0.5rem;
        font-weight: 500;
    }

    .job-location {
        color: var(--primary);
        font-size: 14px;
    }

    .job-desc {
        font-size: 14px;
    }

    @@media screen and (min-width: 1024px) and (max-width: 1339px) {
        .jobs-usp-row {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

            .jobs-usp-row > :nth-child(3) {
                grid-column: 1 / -1;
            }
    }


    @@media screen and (min-width: 600px) and (max-width: 1023px) {
        .jobs-usp-row {
            grid-template-columns: repeat(1, minmax(0, 1fr));
        }

        .orb-scene {
            height: 120vh;
        }

        .banner-text {
            padding-top: 20rem;
        }

        .journey-item {
            padding: 1rem 0;
        }
    }

    @@media (max-width: 600px) {
        .jobs-usp-row {
            grid-template-columns: repeat(1, minmax(0, 1fr));
        }

        .orb-scene {
            height: 160vh;
        }

        .banner-text {
            padding-top: 46rem;
        }
    }

    @@media (max-width: 430px) {
        .orb-scene {
            height: 200vh;
        }

        .banner-text {
            padding-top: 58rem;
        }
    }

    @@media (max-width: 380px) {
        .orb-scene {
            height: 270vh;
        }

        .banner-text {
            padding-top: 80rem;
        }
    }
</style>

@if (data != null)
{
    var items = data.Items.ToList();
    <section class="banner">
        <div class="orb-scene">
            @if (images != null && images.Count > 0 &&
                 !string.IsNullOrWhiteSpace(images[0].ImageUrl))
            {
                <img class="orb orb-1"
                     src="@Url.Content("~/content/uploads/" + images[0].ImageUrl)"
                     alt="@(images[0].AltText ?? "")" />
            }

            @if (images != null && images.Count > 1 &&
                 !string.IsNullOrWhiteSpace(images[1].ImageUrl))
            {
                <img class="orb orb-2"
                     src="@Url.Content("~/content/uploads/" + images[1].ImageUrl)"
                     alt="@(images[1].AltText ?? "")" />
            }




            <div class="banner-text-box">
                <div class="banner-text">

                    <small>@data.SubHeading</small>
                    <h2>
                        @data.Heading
                    </h2>
                    <p>
                        @data.Description
                    </p>
                </div>
                <div class="job-usp-box">
                    <div class="job-usp-container container">
                        <div class="jobs-usp-items-box">
                            <div class="jobs-usp-row row">
                                @foreach (var item in items)
                                {
                                    <div class="jobs-usp-col col-xl-4 col-lg-4 col-md-4 col-12">
                                        <div class="jobs-usp-item">
                                            <h3>
                                                @item.Title
                                            </h3>
                                            <p>
                                                @item.Description

                                            </p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}


