

@model DTOs.ChangePasswordModel

@{
    Layout = null;
    ViewBag.Title = "Change Password";

    bool isFirstLogin = ViewBag.IsFirstLogin != null
        && (bool)ViewBag.IsFirstLogin;
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Change Password</title>

    <link href="~/Content/adminstyle.min.css" rel="stylesheet" />
</head>
<body>
    <div class="page-wrapper min-vh-100 d-flex align-items-center justify-content-center">
        <div class="card" style="width: 100%; max-width: 440px;">
            <div class="card-body p-4">
                <h3 class="mb-2">
                    @(isFirstLogin ? "Set Your New Password" : "Change Your Password")
                </h3>

                <p class="text-muted mb-4">
                    @if (isFirstLogin)
                    {
                        @:For your security, please change your temporary password before continuing.
                    }
                    else
                    {
                        @:Enter your current password and choose a new password.
                    }
                </p>


                @using (Html.BeginForm(
                    "ChangePassword",
                    "Account",
                    FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(
                        true, "", new { @class = "text-danger mb-3" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.CurrentPassword,
                            "Current Password",
                            new { @class = "form-label" })

                        @Html.PasswordFor(m => m.CurrentPassword,
                            new
                                 {
                                     @class = "form-control",
                                  autocomplete = "current-password"
                                 })

                        @Html.ValidationMessageFor(m => m.CurrentPassword,
                            "", new { @class = "text-danger" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.NewPassword,
                            "New Password",
                            new { @class = "form-label" })

                        @Html.PasswordFor(m => m.NewPassword,
                            new
                                 {
                                     @class = "form-control",
                                  autocomplete = "new-password"
                                 })

                        @Html.ValidationMessageFor(m => m.NewPassword,
                            "", new { @class = "text-danger" })

                        <small class="text-muted">
                            Use at least 8 characters.
                        </small>
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(m => m.ConfirmPassword,
                            "Confirm New Password",
                            new { @class = "form-label" })

                        @Html.PasswordFor(m => m.ConfirmPassword,
                            new
                                 {
                                     @class = "form-control",
                                  autocomplete = "new-password"
                                 })

                        @Html.ValidationMessageFor(m => m.ConfirmPassword,
                            "", new { @class = "text-danger" })
                    </div>

                    <button type="submit" class="btn btn-primary w-100">
                        @(isFirstLogin ? "Change Password & Continue" : "Change Password")
                    </button>

                    if (!isFirstLogin)
                    {
                        <a href="@Url.Action("Index", "Admin")"
                           class="btn btn-outline-secondary w-100 mt-2">
                            Cancel
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</body>
</html>
