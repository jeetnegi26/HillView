<div class="study-container container">
    <div class="study-img">
        <img src="@("/Content/Uploads/" + Model.CurrentStudy.CoverImage)"
             alt="@Model.CurrentStudy.Title"
             class="img-fluid" />
    </div>

    <div class="study-content">
        <h2>@Model.CurrentStudy.Title</h2>

        <small>
            @(Model.CurrentStudy.PublishedOn?.ToString("dd MMM yyyy"))
        </small>

        <div class="study-desc">
            @Html.Raw(Model.CurrentStudy.Description)
        </div>
    </div>
</div>

