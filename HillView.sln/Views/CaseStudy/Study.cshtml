<section class="study-section">
    <div class="study-box">
        <div class="study-recent-container container">

            <div class="study-head">
                <h2>Read our case-study</h2>
            </div>

            <div class="study-row row">

                @if (Model.RecentStudies != null && Model.RecentStudies.Any())
                {
                    foreach (var item in Model.RecentStudies)
                    {
                        <div class="col-lg-4 col-md-6 col-12">
                            <div class="study-item">

                                <img src="@("/Content/Uploads/" + item.CoverImage)"
                                     alt="@item.Title"
                                     class="img-fluid"
                                     loading="lazy" />

                                <h2>@item.Title</h2>

                                <p>
                                    @Html.Raw(
                                             System.Text.RegularExpressions.Regex.Replace(
                                                 item.Description ?? "",
                                                 "<.*?>",
                                                 string.Empty
                                             ).Length > 150
                                             ? System.Text.RegularExpressions.Regex.Replace(
                                                 item.Description ?? "",
                                                 "<.*?>",
                                                 string.Empty
                                               ).Substring(0, 150) + "..."
                                             : System.Text.RegularExpressions.Regex.Replace(
                                                 item.Description ?? "",
                                                 "<.*?>",
                                                 string.Empty
                                               )
                                         )
                                </p>

                                <a href="@Url.RouteUrl(new { controller = "CaseStudy", action = "Study", slug = item.RewriteUrl })">
                                    Read More <i class="bi bi-arrow-up-right"></i>
                                </a>

                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12">
                        <p>No other case studies are available.</p>
                    </div>
                }

            </div>
        </div>
    </div>
</section>