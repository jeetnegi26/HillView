@model DTOs.CaseStudyDetailVM

@{
    ViewBag.Title = Model.CurrentStudy.Title;
}

<style>
    .study-container {
        padding-top: 10rem;
        padding-bottom: 3rem;
    }

    .study-content h2 {
        padding-top: 2rem;
        font-weight: 500;
    }

    .study-desc {
        padding-top: 1.5rem;
    }

    .study-content small {
        color: grey;
    }

    .study-head {
        padding-bottom: 1rem;
    }

    .study-box {
        background: var(--lightbg);
    }

    .study-recent-container {
        padding: 3rem 0;
    }

    .study-item {
        padding-bottom: 2rem;
    }

        .study-item imgs {
            border-radius: 25px;
        }

        .study-item h2 {
            padding-top: 10px;
            font-weight: 500;
            font-size: 24px;
        }

        .study-item a {
            cursor: pointer;
            color: var(--primary) !important;
            opacity: 0.8;
            transition: opacity 0.3s ease, color 0.3s ease;
        }

            .study-item a:hover {
                opacity: 1;
            }

        .study-item p {
            font-size: 13px;
        }
</style>

